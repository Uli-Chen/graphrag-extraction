# AGEA query generator (OpenAI-compatible, including Paratera)
AGEA_LLM_PROVIDER=openai_compatible
AGEA_API_BASE=https://llmapi.paratera.com/v1/
AGEA_API_KEY=replace-me
QUERY_GENERATOR=DeepSeek-V4-Flash-0731
AGEA_QUERY_MAX_TOKENS=3072

# GraphRAG chat model
GRAPHRAG_API_BASE=https://llmapi.paratera.com/v1/
GRAPHRAG_API_KEY=replace-me
GRAPHRAG_CHAT_MODEL=DeepSeek-V4-Flash-0731

# GraphRAG embedding model (configure an OpenAI-compatible embedding endpoint)
GRAPHRAG_EMBEDDING_API_BASE=https://your-embedding-endpoint/v1/
GRAPHRAG_EMBEDDING_API_KEY=replace-me
GRAPHRAG_EMBEDDING_MODEL=replace-me

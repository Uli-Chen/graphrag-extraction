      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Sir John Colborne took over administration from Gosford after Gosford went home. Sir John Colborne took over administration from Gosford.</data>
      <data key="d8">SIR JOHN COLBORNE</data>
    </edge>
    <edge source="SIR JOHN COLBORNE" target="EARL OF DURHAM" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Sir John Colborne handed over the problem of political prisoners to Lord Durham. Sir John Colborne handed over responsibility for political prisoners to Lord Durham.</data>
      <data key="d8">SIR JOHN COLBORNE</data>
    </edge>

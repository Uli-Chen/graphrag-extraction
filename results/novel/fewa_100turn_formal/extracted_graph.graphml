      <data key="d11">Gorlois was the husband of Ygrayne, and their story is part of the Arthurian legend</data>
      <data key="d12">GORLOIS</data>
    </edge>
    <edge source="YGRAYNE" target="TERRABIL" id="related_to">
      <data key="d7">YGRAYNE</data>
      <data key="d8">TERRABIL</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>

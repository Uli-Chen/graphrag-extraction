      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Hercules and Achelous contested for Deianira.</data>
      <data key="d12">ACHELOUS</data>
    </edge>
    <edge source="ACHELOUS" target="DEIANIRA" id="related_to">
      <data key="d7">ACHELOUS</data>
      <data key="d8">DEIANIRA</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Achelous, the river god, loved Deianira, holding her in higher regard than his own domains of Calydon and tolia. He actively sought her as his bride, making clear his deep affection and desire for her.</data>
      <data key="d12">DEIANIRA</data>
    </edge>

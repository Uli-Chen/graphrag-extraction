    <edge source="OVID" target="MEDEA" id="related_to">
      <data key="d7">OVID</data>
      <data key="d8">MEDEA</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Ovid, the Roman poet, is the author of the tragedy *Medea*, a work that is now lost and no longer exists. The play, which was part of his dramatic output, is known only through references and fragments, as the full text has not survived to the present day.</data>
      <data key="d12">MEDEA</data>
    </edge>

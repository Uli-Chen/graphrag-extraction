    <edge source="IMAGING TESTS" target="FDG-PET/CT" id="related_to">
      <data key="d7">IMAGING TESTS</data>
      <data key="d8">FDG-PET/CT</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">FDG-PET/CT is an imaging test that belongs to the broader category of imaging tests. Specifically, it is a type of PET/CT imaging test, and it is described at the end of the text.</data>
      <data key="d12">FDG-PET/CT</data>
    </edge>

      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">MSI-H is often due to deficient mismatch repair</data>
      <data key="d12">DEFICIENT MISMATCH REPAIR</data>
    </edge>
    <edge source="DEFICIENT MISMATCH REPAIR" target="MSI-H/DMMR MUTATION" id="related_to">

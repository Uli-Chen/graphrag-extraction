    <edge source="CYSTOSCOPY" target="BLUE LIGHT CYSTOSCOPY" id="related_to">
      <data key="d7">CYSTOSCOPY</data>
      <data key="d8">BLUE LIGHT CYSTOSCOPY</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Cystoscopy is a medical procedure that allows doctors to examine the inside of the bladder and urethra. Blue light cystoscopy is a newer, specialized type of cystoscopy that enhances this examination. It uses blue light and a photosensitizing dye, which causes abnormal tissue to appear differently under the blue light, aiding in the detection and evaluation of conditions such as bladder cancer. Together, cystoscopy and blue light cystoscopy represent standard and advanced approaches to urological diagnosis and treatment.</data>
      <data key="d12">CYSTOSCOPY</data>
    </edge>
    <edge source="CYSTOSCOPY" target="NARROW-BAND IMAGING" id="related_to">
      <data key="d7">CYSTOSCOPY</data>
      <data key="d8">NARROW-BAND IMAGING</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Narrow-band imaging is used during cystoscopy to detect tumors more clearly</data>
      <data key="d12">NARROW-BAND IMAGING</data>
    </edge>
    <edge source="CYSTOSCOPY" target="WHITE LIGHT CYSTOSCOPY" id="related_to">
      <data key="d7">CYSTOSCOPY</data>
      <data key="d8">WHITE LIGHT CYSTOSCOPY</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">White light cystoscopy is the standard form of cystoscopy that uses white light</data>
      <data key="d12">WHITE LIGHT CYSTOSCOPY</data>
    </edge>

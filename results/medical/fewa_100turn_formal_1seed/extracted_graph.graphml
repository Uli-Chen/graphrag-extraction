      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Biopsy can be done during cystoscopy using a small tool on the cystoscope to remove suspicious tissue; if not done then, it may be scheduled separately</data>
      <data key="d12">CYSTOSCOPY</data>
    </edge>
    <edge source="CYSTOSCOPY" target="PROCTOSCOPY" id="related_to">
      <data key="d7">CYSTOSCOPY</data>
      <data key="d8">PROCTOSCOPY</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Both are procedures used under anesthesia to examine organs for signs of cancer</data>
      <data key="d12">CYSTOSCOPY</data>
    </edge>
    <edge source="CYSTOSCOPY" target="IMAGING" id="related_to">
      <data key="d7">CYSTOSCOPY</data>
      <data key="d8">IMAGING</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">If cystoscopy does not find cancer in the urethra or bladder, imaging tests are used to investigate the ureters, kidneys, or other areas</data>
      <data key="d12">CYSTOSCOPY</data>
    </edge>
    <edge source="CYSTOSCOPY" target="TESTING" id="related_to">
      <data key="d7">CYSTOSCOPY</data>

    </edge>
    <edge source="MICROSATELLITE INSTABILITY" target="BIOMARKER TESTING" id="related_to">
      <data key="d7">MICROSATELLITE INSTABILITY</data>
      <data key="d8">BIOMARKER TESTING</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>

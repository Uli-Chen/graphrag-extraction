    <edge source="ENDOSCOPIC ULTRASOUND" target="CLINICAL PRE-SURGERY STAGE" id="related_to">
      <data key="d7">ENDOSCOPIC ULTRASOUND</data>
      <data key="d8">CLINICAL PRE-SURGERY STAGE</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>

      <data key="d11">BCR::ABL1 produces a protein that leads to uncontrolled blood cell growth, ultimately causing CML.</data>
      <data key="d12">CHRONIC MYELOID LEUKEMIA</data>
    </edge>
    <edge source="CHRONIC MYELOID LEUKEMIA" target="BLAST PHASE CML" id="related_to">

      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Ureteroscopy is a very similar exam to cystoscopy but goes farther to examine the ureters and inner kidneys</data>
      <data key="d12">CYSTOSCOPY</data>

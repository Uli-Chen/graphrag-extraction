      <data key="d10">1.0</data>
      <data key="d11">Pre-treatment surgical staging may remove and test para-aortic nodes.</data>
      <data key="d12">PRE-TREATMENT SURGICAL STAGING</data>
    </edge>
    <edge source="PRE-TREATMENT SURGICAL STAGING" target="LAPAROSCOPIC SURGICAL STAGING" id="related_to">

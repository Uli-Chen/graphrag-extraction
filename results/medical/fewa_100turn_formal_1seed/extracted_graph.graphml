    <edge source="POSITRON EMISSION TOMOGRAPHY (PET)" target="MAGNETIC RESONANCE IMAGING (MRI)" id="related_to">
      <data key="d7">POSITRON EMISSION TOMOGRAPHY (PET)</data>
      <data key="d8">MAGNETIC RESONANCE IMAGING (MRI)</data>
      <data key="d9">related_to</data>

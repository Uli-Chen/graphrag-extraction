    <edge source="ENDOSCOPIC ULTRASOUND" target="PELVIC MAGNETIC RESONANCE IMAGING" id="related_to">
      <data key="d7">ENDOSCOPIC ULTRASOUND</data>
      <data key="d8">PELVIC MAGNETIC RESONANCE IMAGING</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Both are imaging options recommended for sessile polyps to help guide decisions about surgery.</data>

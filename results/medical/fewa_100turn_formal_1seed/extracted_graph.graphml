    <edge source="COLONOSCOPY" target="SURVEILLANCE" id="related_to">
      <data key="d7">COLONOSCOPY</data>
      <data key="d8">SURVEILLANCE</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>

      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The alkaline phosphatase test is one of the blood tests described in the text.</data>
      <data key="d12">ALKALINE PHOSPHATASE TEST</data>
    </edge>
    <edge source="ALKALINE PHOSPHATASE TEST" target="BONE SCAN" id="related_to">
      <data key="d7">ALKALINE PHOSPHATASE TEST</data>
      <data key="d8">BONE SCAN</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">A bone scan might be performed if a patient has high levels of alkaline phosphatase.</data>

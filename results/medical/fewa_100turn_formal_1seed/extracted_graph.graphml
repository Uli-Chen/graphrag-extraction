    <edge source="FDG-PET/CT" target="BONE SCAN" id="related_to">
      <data key="d7">FDG-PET/CT</data>
      <data key="d8">BONE SCAN</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>

      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Cystoscopy is a testing procedure used to look for signs of cancer in the bladder</data>
      <data key="d12">CYSTOSCOPY</data>
    </edge>
    <edge source="CYSTOSCOPY" target="TUMOR REMOVAL" id="related_to">

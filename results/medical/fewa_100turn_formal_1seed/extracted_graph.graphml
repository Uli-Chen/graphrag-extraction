    <node id="RELATIONSHIP: PET/CT SCAN → PET SCAN">
      <data key="d0">RELATIONSHIP: PET/CT SCAN → PET SCAN</data>
      <data key="d1">RELATIONSHIP: PET/CT SCAN → PET SCAN</data>
      <data key="d2">extracted</data>

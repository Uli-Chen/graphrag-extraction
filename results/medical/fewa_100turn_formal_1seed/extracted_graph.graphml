    <edge source="QUESTIONS TO ASK" target="PATIENT" id="related_to">
      <data key="d7">QUESTIONS TO ASK</data>
      <data key="d8">PATIENT</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The Questions to Ask section helps patients ask their care team questions</data>
      <data key="d12">QUESTIONS TO ASK</data>

    <edge source="CANCER STAGING" target="NASOPHARYNGEAL CANCER STAGING" id="related_to">
      <data key="d7">CANCER STAGING</data>
      <data key="d8">NASOPHARYNGEAL CANCER STAGING</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>

    <edge source="RADIATION-INDUCED MENOPAUSE" target="CERVICAL CANCER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Radiation therapy for cervical cancer can cause radiation-induced menopause.</data>

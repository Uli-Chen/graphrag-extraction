      <data key="d7">Treatment trials are done in phases, including Phase 2 trials.</data>
      <data key="d8">TREATMENT TRIAL</data>
    </edge>
    <edge source="CLINICAL STAGING" target="CANCER STAGING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Clinical staging is a type of cancer staging assigned before any treatment is initiated.</data>
      <data key="d8">CLINICAL STAGING</data>
    </edge>
    <edge source="CLINICAL STAGING" target="PHYSICAL EXAM" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Clinical staging is based on a physical exam</data>
      <data key="d8">PHYSICAL EXAM</data>
    </edge>
    <edge source="CLINICAL STAGING" target="BREAST EXAM" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The breast exam is part of the physical exam that contributes to clinical staging</data>
      <data key="d8">BREAST EXAM</data>
    </edge>
    <edge source="PHASE 1 TRIALS" target="PHASE 2 TRIALS" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Phase 1 and Phase 2 are sequential phases in the clinical trial process</data>
      <data key="d8">PHASE 1 TRIALS</data>
    </edge>
    <edge source="PHASE 1 TRIAL" target="PHASE 2" id="0">
      <data key="d5">related_to</data>

      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The patient may have biomarker testing to determine prostate cancer risk.</data>
      <data key="d8">PATIENT</data>
    </edge>
    <edge source="MOLECULAR BIOMARKER TESTING" target="TREATMENT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Biomarker testing results indicate whether treatment should be avoided or delayed.</data>
      <data key="d8">MOLECULAR BIOMARKER TESTING</data>
    </edge>
    <edge source="MOLECULAR BIOMARKER TESTING" target="SURGERY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">If molecular biomarker testing indicates lower-risk cancer, surgery may be avoided or delayed.</data>
      <data key="d8">MOLECULAR BIOMARKER TESTING</data>
    </edge>
    <edge source="MOLECULAR BIOMARKER TESTING" target="CARE TEAM" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The care team considers biomarker testing results when assessing risk.</data>
      <data key="d8">MOLECULAR BIOMARKER TESTING</data>
    </edge>
    <edge source="MOLECULAR BIOMARKER TESTING" target="RADIATION THERAPY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">If molecular biomarker testing indicates lower-risk cancer, radiation therapy may be avoided or delayed.</data>
      <data key="d8">MOLECULAR BIOMARKER TESTING</data>
    </edge>
    <edge source="MYCHART" target="PATIENT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">MyChart is a patient portal that allows patients to access test results, track appointments, and communicate with their care team. A patient may set up MyChart specifically to track appointments and communicate with their care team, thereby gaining access to these features and maintaining ongoing engagement with their healthcare providers.</data>
      <data key="d8">PATIENT</data>
    </edge>

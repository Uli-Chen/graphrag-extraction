    <edge source="OVARIAN CANCER" target="PELVIC EXAM" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The pelvic exam checks for abnormal changes in the ovaries and nearby reproductive organs that could indicate ovarian cancer.</data>
      <data key="d8">PELVIC EXAM</data>
    </edge>
    <edge source="OVARIAN CANCER" target="ABDOMINAL AND PELVIC EXAM" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">This exam is used when ovarian cancer is suspected to detect abnormalities in the abdomen, ovaries, cervix, and uterus.</data>

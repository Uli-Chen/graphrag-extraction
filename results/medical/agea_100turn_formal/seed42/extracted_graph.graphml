      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Testing for mouth cancer is part of treatment planning. Treatment planning starts with testing.</data>
      <data key="d8">TESTING FOR MOUTH CANCER</data>
    </edge>
    <edge source="TREATMENT PLANNING" target="ENDOSCOPY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Endoscopy is an as-needed test in treatment planning.</data>
      <data key="d8">ENDOSCOPY</data>
    </edge>
    <edge source="TREATMENT PLANNING" target="HELP TO QUIT SMOKING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Help to quit smoking is an as-needed part of treatment planning.</data>

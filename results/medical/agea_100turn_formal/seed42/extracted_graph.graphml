    <edge source="TREATMENT PLANNING" target="DUCTAL CARCINOMA IN SITU" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Treatment planning starts with testing for DCIS and aims to treat the condition to prevent invasive breast cancer.</data>

      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Endorectal ultrasound is an imaging test that can show the extent of cancer in the pelvis</data>
      <data key="d8">ENDORECTAL ULTRASOUND</data>
    </edge>
    <edge source="IMAGING TESTS" target="TRANSECTAL ULTRASOUND" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Transrectal ultrasound is an imaging method used to measure prostate size.</data>

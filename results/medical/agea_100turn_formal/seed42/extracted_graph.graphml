      <data key="d8">NEUROPATHOLOGIST</data>
    </edge>
    <edge source="NEUROPATHOLOGIST" target="LABORATORY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The neuropathologist works in association with the laboratory to examine biopsy samples.</data>
      <data key="d8">NEUROPATHOLOGIST</data>
    </edge>
    <edge source="NEUROPATHOLOGIST" target="HOSPITAL" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">A hospital may or may not have a neuropathologist available; if not, the biopsy can be sent to one.</data>
      <data key="d8">NEUROPATHOLOGIST</data>
    </edge>
    <edge source="NEUROPATHOLOGIST" target="MEDICAL CENTER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">A medical center may or may not have a neuropathologist available; if not, the biopsy can be sent to one.</data>
      <data key="d8">NEUROPATHOLOGIST</data>
    </edge>
    <edge source="HISTOLOGY" target="TREATMENT TEAM" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Histology helps classify the tumor and contributes to the full description used to plan treatment.</data>
      <data key="d8">TREATMENT TEAM</data>
    </edge>
    <edge source="HISTOLOGY" target="NEUROSURGEON" id="0">
      <data key="d5">related_to</data>

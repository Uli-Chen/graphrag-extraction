    </edge>
    <edge source="PHASE 2 TRIALS" target="PHASE 3 TRIALS" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Phase 2 and Phase 3 are sequential phases in the clinical trial process.</data>
      <data key="d8">PHASE 3 TRIALS</data>
    </edge>

    <edge source="SUPPORTIVE CARE" target="CANCER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Supportive care aims to relieve symptoms of cancer and side effects of cancer treatment.</data>

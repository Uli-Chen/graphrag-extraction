      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">MRI is used to evaluate breast tissue and breast cancer</data>
      <data key="d8">BREAST CANCER</data>
    </edge>
    <edge source="BREAST CANCER" target="ULTRASOUND" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Ultrasound is used to evaluate breast tissue and breast cancer</data>
      <data key="d8">BREAST CANCER</data>
    </edge>
    <edge source="BREAST CANCER" target="MAMMOGRAM" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Mammograms are used to image and screen for breast cancer</data>
      <data key="d8">BREAST CANCER</data>
    </edge>
    <edge source="BREAST CANCER" target="BREAST CANCER SCREENING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Breast cancer screening aims to detect breast cancer early, when it can be treated more successfully</data>
      <data key="d8">BREAST CANCER</data>
    </edge>
    <edge source="BREAST CANCER" target="BREAST EXAM" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Breast exams help find breast cancer at earlier, more treatable stages</data>
      <data key="d8">BREAST CANCER</data>
    </edge>
    <edge source="BREAST CANCER" target="DIAGNOSTIC MAMMOGRAM" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Diagnostic mammograms are used when symptoms such as a lump, pain, or nipple changes may indicate breast cancer.</data>
      <data key="d8">BREAST CANCER</data>
    </edge>
    <edge source="BREAST CANCER" target="NEEDLE BIOPSY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Needle biopsy is performed as needed for breast cancer diagnosis</data>
      <data key="d8">BREAST CANCER</data>
    </edge>
    <edge source="BREAST CANCER" target="HEALTH CHECKUP" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Health checkups can include breast cancer screening and discussion of breast health</data>
      <data key="d8">BREAST CANCER</data>
    </edge>
    <edge source="BREAST CANCER" target="METASTATIC BREAST CANCER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Metastatic breast cancer is advanced breast cancer that has spread beyond the breast and nearby lymph nodes. It is a form of breast cancer characterized by the movement of cancer cells from the original tumor site to other parts of the body. Breast cancer, in its earlier stages, is typically confined to the breast tissue and possibly nearby lymph nodes; however, when it becomes metastatic, the disease has progressed to a more advanced stage. Thus, metastatic breast cancer represents the most severe form of breast cancer, in which the cancer has escaped the local region and established itself in distant organs or tissues.</data>
      <data key="d8">BREAST CANCER</data>
    </edge>
    <edge source="BREAST CANCER" target="MAMMOGRAM SCREENING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Mammogram screening detects breast cancer</data>
      <data key="d8">BREAST CANCER</data>
    </edge>
    <edge source="BREAST CANCER" target="BREASTFEEDING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Breastfeeding is a condition considered in breast cancer screening and testing discussions</data>
      <data key="d8">BREAST CANCER</data>
    </edge>
    <edge source="BREAST CANCER" target="SCREENING MAMMOGRAM" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Screening mammograms are performed routinely to look for breast cancer when there are no signs or symptoms.</data>

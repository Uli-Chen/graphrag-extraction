      <data key="d8">NEUROSURGEON</data>
    </edge>
    <edge source="HISTOLOGY" target="NEUROPATHOLOGIST" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The neuropathologist performs histologic analysis when inspecting tissue under a microscope.</data>
      <data key="d8">NEUROPATHOLOGIST</data>
    </edge>
    <edge source="LABORATORY" target="TREATMENT TEAM" id="0">
      <data key="d5">related_to</data>

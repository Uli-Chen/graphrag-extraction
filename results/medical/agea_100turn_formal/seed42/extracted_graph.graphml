    </edge>
    <edge source="TREATMENT PLANNING" target="FERTILITY COUNSELING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Fertility counseling is an as-needed part of treatment planning.</data>

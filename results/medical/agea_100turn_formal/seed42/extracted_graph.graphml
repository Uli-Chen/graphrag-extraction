    </edge>
    <edge source="NEUROPATHOLOGIST" target="TREATMENT TEAM" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Neuropathologist findings and diagnostic information help the treatment team plan treatment.</data>
      <data key="d8">TREATMENT TEAM</data>
    </edge>

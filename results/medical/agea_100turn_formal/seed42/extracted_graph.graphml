      <data key="d7">Talk therapy can help people with cancer manage anxiety, depression, and stress.</data>
      <data key="d8">CANCER</data>
    </edge>
    <edge source="INSURANCE" target="STUDY SPONSOR" id="0">
      <data key="d5">related_to</data>

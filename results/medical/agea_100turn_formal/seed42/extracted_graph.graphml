      <data key="d7">Nicotine withdrawal is challenging for most people who smoke or vape.</data>
      <data key="d8">NICOTINE WITHDRAWAL</data>
    </edge>
    <edge source="BETOBACCOFREE" target="PATIENT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">BeTobaccoFree is an online support resource for the patient to quit smoking or vaping</data>
      <data key="d8">PATIENT</data>
    </edge>
    <edge source="CIRRHOSIS" target="LIVER CANCER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Cirrhosis is a major risk factor for the development of liver cancer. It is formally listed as a risk factor for liver cancer, and clinical comparisons are often made between individuals who have cirrhosis and those who do not, highlighting the elevated risk associated with the condition. In this context, cirrhosis and liver cancer are closely linked, with cirrhosis representing a significant predisposing condition for the onset of liver cancer.</data>
      <data key="d8">CIRRHOSIS</data>
    </edge>
    <edge source="CIRRHOSIS" target="NON-ALCOHOLIC FATTY LIVER DISEASE (NAFLD)" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">NAFLD may lead to cirrhosis.</data>
      <data key="d8">CIRRHOSIS</data>
    </edge>
    <edge source="CIRRHOSIS" target="HEPATITIS B" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Hepatitis B virus or infection can cause cirrhosis.</data>
      <data key="d8">CIRRHOSIS</data>
    </edge>
    <edge source="CIRRHOSIS" target="HEPATITIS C" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Hepatitis C virus or infection can cause cirrhosis.</data>
      <data key="d8">CIRRHOSIS</data>
    </edge>
    <edge source="CIRRHOSIS" target="HEPATITIS" id="0">
      <data key="d5">related_to</data>

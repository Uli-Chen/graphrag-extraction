      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">CDC.gov/tobacco is listed as an online support resource to help people quit smoking</data>
      <data key="d8">CDC.GOV/TOBACCO</data>
    </edge>

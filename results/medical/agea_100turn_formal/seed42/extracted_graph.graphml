    <edge source="PATHOLOGIST" target="SKIN BIOPSY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">A pathologist reviews a skin biopsy sample to determine whether squamous cell skin cancer is present. By analyzing the tissue sample obtained during the skin biopsy, the pathologist identifies the specific type and subtype of cancer, providing a precise diagnosis.</data>
      <data key="d8">SKIN BIOPSY</data>
    </edge>
    <edge source="STAGING" target="INTERNATIONAL FEDERATION OF GYNECOLOGY AND OBSTETRICS" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">For cervical cancer, staging uses the FIGO system, which is the standard framework for rating the extent of the disease before treatment.</data>
      <data key="d8">STAGING</data>
    </edge>
    <edge source="STAGING" target="AMERICAN JOINT COMMITTEE ON CANCER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>

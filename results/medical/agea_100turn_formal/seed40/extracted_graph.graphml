      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Medical history includes family history.</data>
      <data key="d8">FAMILY HISTORY</data>
    </edge>
    <edge source="FAMILY HISTORY" target="PROSTATE CANCER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">A family history of prostate cancer means a higher chance of developing prostate cancer</data>
      <data key="d8">FAMILY HISTORY</data>
    </edge>
    <edge source="FAMILY HISTORY" target="CARE TEAM" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The care team is responsible for collecting and reviewing information related to family history as part of patient assessments. Specifically, the care team asks about family history, gathering details about the patient's relatives and their health conditions. This process is also described as asking about the family medical history, meaning the care team solicits information regarding any medical conditions, diseases, or health patterns that may run in the patient's family. In practice, the care team's inquiry into family history encompasses the broader family medical history, ensuring that relevant hereditary and genetic factors are considered in the patient's overall care plan.</data>
      <data key="d8">FAMILY HISTORY</data>
    </edge>

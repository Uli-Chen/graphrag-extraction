      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">RADIATION THERAPY is a type of TREATMENT</data>
      <data key="d8">RADIATION THERAPY</data>
    </edge>
    <edge source="RADIATION THERAPY" target="FATIGUE" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Fatigue may begin after radiation therapy has finished and last for several weeks.</data>
      <data key="d8">FATIGUE</data>
    </edge>

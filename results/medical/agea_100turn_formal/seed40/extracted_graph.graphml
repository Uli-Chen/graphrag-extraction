    </edge>
    <edge source="PELVIC MRI" target="SURVEILLANCE" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Pelvic MRI with contrast is recommended during surveillance after ESD and after transanal local excision</data>
      <data key="d8">PELVIC MRI</data>
    </edge>
    <edge source="FDG-PET/CT" target="BONE SCAN" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">If FDG-PET/CT clearly shows cancer in the bone, a bone scan may not be needed.</data>
      <data key="d8">FDG-PET/CT</data>
    </edge>
    <edge source="FDG-PET/CT" target="CT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">FDG-PET/CT combines positron emission tomography with computed tomography (CT) imaging.</data>
      <data key="d8">FDG-PET/CT</data>
    </edge>
    <edge source="FDG-PET/CT" target="SODIUM FLUORIDE PET/CT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">FDG-PET/CT and sodium fluoride PET/CT are two imaging techniques used to evaluate cancer, particularly in bone. When FDG-PET/CT clearly demonstrates the presence of cancer in the bone, a subsequent sodium fluoride PET/CT scan may not be required. In other words, if the FDG-PET/CT already provides unambiguous evidence of bone involvement, the additional information from a sodium fluoride PET/CT is considered unnecessary. This guidance applies to both modalities, emphasizing that a clear positive result on FDG-PET/CT can eliminate the need for further sodium fluoride PET/CT imaging in the same clinical context.</data>
      <data key="d8">FDG-PET/CT</data>
    </edge>
    <edge source="FOLLOW-UP TESTING" target="RECURRENCE" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Follow-up testing checks whether bladder cancer has returned</data>
      <data key="d8">RECURRENCE</data>
    </edge>
    <edge source="FOLLOW-UP TESTING" target="BLADDER CANCER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">People with bladder cancer need regular follow-up testing.</data>
      <data key="d8">BLADDER CANCER</data>
    </edge>
    <edge source="SURVEILLANCE" target="RECURRENCE" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Surveillance is performed to detect cancer recurrence or new cancer growth early.</data>
      <data key="d8">RECURRENCE</data>
    </edge>
    <edge source="SURVEILLANCE" target="CANCER PROGRESSION" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Surveillance and testing aim to detect cancer progression or relapse early.</data>
      <data key="d8">CANCER PROGRESSION</data>
    </edge>
    <edge source="POSITRON EMISSION TOMOGRAPHY (PET)" target="ANAL CANCER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">PET may be combined with CT or MRI to detect cancer spread</data>
      <data key="d8">POSITRON EMISSION TOMOGRAPHY (PET)</data>
    </edge>
    <edge source="POSITRON EMISSION TOMOGRAPHY" target="MAGNETIC RESONANCE IMAGING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">PET may be performed with MRI instead of CT in some cases.</data>
      <data key="d8">POSITRON EMISSION TOMOGRAPHY (PET)</data>
    </edge>
    <edge source="POSITRON EMISSION TOMOGRAPHY" target="PET/CT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">PET is the emission-imaging component of PET/CT; PET/CT combines PET with CT.</data>
      <data key="d8">POSITRON EMISSION TOMOGRAPHY (PET)</data>
    </edge>
    <edge source="PET/CT SCAN" target="PET SCAN" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">A PET/CT scan combines PET scanning with CT imaging in a single procedure.</data>
      <data key="d8">PET SCAN</data>
    </edge>
    <edge source="PET/CT SCAN" target="FDG-PET/CT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">FDG-PET/CT is a specific type of PET/CT scan. A PET/CT scan combines positron emission tomography (PET) and computed tomography (CT) into a single imaging procedure. FDG-PET/CT specifically uses a radiotracer called fluorodeoxyglucose (FDG), which is a glucose analog. This radiotracer is injected into the body, and the PET/CT scanner detects its distribution to evaluate metabolic activity, often used in oncology, cardiology, and neurology. Thus, FDG-PET/CT is defined as a PET/CT scan that employs fluorodeoxyglucose (FDG) as its radiotracer. In essence, FDG-PET/CT is a PET/CT scan using FDG, making it a specialized application of the broader PET/CT imaging technique.</data>
      <data key="d8">FDG-PET/CT</data>
    </edge>
    <edge source="PSMA-PET SCAN" target="RECURRENCE" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">PSMA-PET is mostly used to monitor prostate cancer for recurrence</data>
      <data key="d8">RECURRENCE</data>
    </edge>
    <edge source="PET-CT SCAN" target="FDG PET-CT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">FDG PET-CT is a PET-CT variant using F-18 fluorodeoxyglucose</data>
      <data key="d8">PET-CT SCAN</data>
    </edge>
    <edge source="PET-CT SCAN" target="SODIUM FLUORIDE PET-CT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Sodium fluoride PET-CT is a PET-CT variant using a sodium fluoride radiotracer</data>
      <data key="d8">PET-CT SCAN</data>
    </edge>
    <edge source="PET-CT SCAN" target="FES PET-CT" id="0">

    <edge source="MAMMOGRAM" target="MAMMOGRAM SCREENING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Mammogram screening is the use of mammograms to screen for breast cancer</data>

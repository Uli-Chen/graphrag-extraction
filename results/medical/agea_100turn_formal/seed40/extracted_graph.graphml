    <edge source="CHEMOTHERAPY" target="NEUROPATHY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Oxaliplatin, a chemotherapy drug, can cause nerve damage (neuropathy) to fingers and toes. Symptoms include numbness, cramping, tingling, or pain in these areas. (This relationship is supported by the source text describing oxaliplatin's side effects, though it is not explicitly listed as a separate relationship in the data tables.)</data>
      <data key="d8">NEUROPATHY</data>
    </edge>

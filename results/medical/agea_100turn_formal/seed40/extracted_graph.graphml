      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Diarrhea is a common side effect of EBRT.</data>
      <data key="d8">DIARRHEA</data>
    </edge>
    <edge source="EXTERNAL BEAM RADIATION THERAPY" target="NAUSEA" id="0">
      <data key="d5">related_to</data>

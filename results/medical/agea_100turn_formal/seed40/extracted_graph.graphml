      <data key="d8">VAPING</data>
    </edge>
    <edge source="SMOKEFREE.GOV" target="QUITTING SMOKING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">SmokeFree.gov is listed as an online support resource to help people quit smoking</data>
      <data key="d8">QUITTING SMOKING</data>
    </edge>
    <edge source="SMOKEFREE.GOV" target="CDC.GOV/TOBACCO" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">SmokeFree.gov and CDC.gov/tobacco are both recognized as recommended online resources for quitting smoking and vaping. They are frequently listed together as credible, web-based smoking cessation support options, providing individuals with accessible tools and information to help them stop using tobacco products or e-cigarettes. Both websites serve as authoritative sources of guidance for those seeking to quit.</data>
      <data key="d8">CDC.GOV/TOBACCO</data>
    </edge>
    <edge source="SMOKEFREE.GOV" target="BETOBACCOFREE.GOV" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">SmokeFree.gov and BeTobaccoFree.gov are two online support websites that are listed together as recommended resources for individuals seeking help to quit smoking, tobacco use, and vaping. Both are highlighted as trusted digital cessation support options, offering guidance and tools for those ready to stop using tobacco products or e-cigarettes.</data>
      <data key="d8">SMOKEFREE.GOV</data>
    </edge>
    <edge source="SMOKEFREE.GOV" target="CANCER TREATMENT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Stopping smoking or vaping is essential to maximize the chance of cure and minimize side effects from cancer treatment; SmokeFree.gov is an online resource to help quit.</data>
      <data key="d8">SMOKEFREE.GOV</data>
    </edge>
    <edge source="ACTIVE SURVEILLANCE" target="PATIENT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The patient may be on active surveillance, which involves repeated biopsies.</data>
      <data key="d8">PATIENT</data>
    </edge>
    <edge source="ACTIVE SURVEILLANCE" target="MOLECULAR BIOMARKER TESTING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Biomarker testing can identify lower-risk patients suitable for active surveillance.</data>
      <data key="d8">MOLECULAR BIOMARKER TESTING</data>
    </edge>
    <edge source="MOLECULAR BIOMARKER TESTING" target="PATIENT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The patient may have biomarker testing to determine prostate cancer risk.</data>
      <data key="d8">PATIENT</data>
    </edge>
    <edge source="MOLECULAR BIOMARKER TESTING" target="TREATMENT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Biomarker testing results indicate whether treatment should be avoided or delayed.</data>
      <data key="d8">MOLECULAR BIOMARKER TESTING</data>
    </edge>
    <edge source="MOLECULAR BIOMARKER TESTING" target="SURGERY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">If molecular biomarker testing indicates lower-risk cancer, surgery may be avoided or delayed.</data>
      <data key="d8">MOLECULAR BIOMARKER TESTING</data>
    </edge>
    <edge source="MOLECULAR BIOMARKER TESTING" target="CARE TEAM" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The care team considers biomarker testing results when assessing risk.</data>
      <data key="d8">MOLECULAR BIOMARKER TESTING</data>
    </edge>
    <edge source="MOLECULAR BIOMARKER TESTING" target="RADIATION THERAPY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">If molecular biomarker testing indicates lower-risk cancer, radiation therapy may be avoided or delayed.</data>
      <data key="d8">MOLECULAR BIOMARKER TESTING</data>
    </edge>
    <edge source="APPOINTMENTS" target="PATIENT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The patient has appointments that can be tracked in MyChart.</data>
      <data key="d8">PATIENT</data>
    </edge>
    <edge source="EYE EXAM" target="PRIMARY CNS LYMPHOMA" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">An eye exam is performed because primary CNS lymphoma can affect the eyes</data>
      <data key="d8">PRIMARY CNS LYMPHOMA</data>
    </edge>
    <edge source="SMOKING OR VAPING" target="NICOTINE WITHDRAWAL" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Nicotine withdrawal is challenging for most people who smoke or vape</data>
      <data key="d8">SMOKING OR VAPING</data>
    </edge>
    <edge source="BETOBACCOFREE" target="PATIENT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">BeTobaccoFree is an online support resource for the patient to quit smoking or vaping</data>
      <data key="d8">PATIENT</data>
    </edge>
    <edge source="AMERICAN JOINT COMMITTEE ON CANCER" target="PATHOLOGIC STAGING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The American Joint Committee on Cancer developed one of the staging systems used for pathologic staging of ovarian cancer</data>
      <data key="d8">PATHOLOGIC STAGING</data>
    </edge>
    <edge source="AMERICAN JOINT COMMITTEE ON CANCER" target="NPC STAGING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The AJCC staging system is used in NPC staging.</data>
      <data key="d8">NPC STAGING</data>
    </edge>
    <edge source="CLINICAL STAGING" target="PATHOLOGIC STAGING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Clinical and pathologic staging are two related time points in cancer staging; clinical is before treatment, pathologic is determined after surgery.</data>
      <data key="d8">PATHOLOGIC STAGING</data>
    </edge>
    <edge source="PATHOLOGIC STAGING" target="SURGERY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">PATHOLOGIC STAGING is the process of determining the extent of disease by examining tissue that has been removed during SURGERY. This staging method relies on the analysis of surgical specimens, as the tissue obtained through the surgical procedure provides the material necessary for pathologic evaluation.</data>
      <data key="d8">SURGERY</data>
    </edge>
    <edge source="PATHOLOGIC STAGING" target="HYSTERECTOMY AND BSO" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Information gained during surgery contributes to determining the pathologic stage of ovarian cancer</data>
      <data key="d8">HYSTERECTOMY AND BSO</data>
    </edge>
    <edge source="PATHOLOGIC STAGING" target="PATHOLOGIST" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">A pathologist performs pathologic staging based on findings from removed tissue and lymph nodes</data>
      <data key="d8">PATHOLOGIC STAGING</data>
    </edge>
    <edge source="PATHOLOGIC STAGING" target="LYMPH NODE REMOVAL" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Pathologic staging may examine a lymph node removed during surgery.</data>
      <data key="d8">PATHOLOGIC STAGING</data>
    </edge>
    <edge source="PATHOLOGIC STAGING" target="CANCER STAGING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Cancer staging is the overall process of determining the extent of cancer in the body. It is often performed as pathologic staging after surgery. Pathologic staging is the post-surgery portion of cancer staging, determined from surgical tissue.</data>
      <data key="d8">PATHOLOGIC STAGING</data>
    </edge>
    <edge source="RECTAL CANCER" target="SURGICAL STAGING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Surgical staging determines how far the rectal cancer has grown and whether lymph nodes contain cancer</data>
      <data key="d8">SURGICAL STAGING</data>
    </edge>
    <edge source="RECTAL CANCER" target="STAGE 1 RECTAL CANCER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Rectal cancer can be assigned stage 1 when the tumor has grown into the second or third muscle layer of the rectal wall</data>
      <data key="d8">RECTAL CANCER</data>
    </edge>
    <edge source="RECTAL CANCER" target="CHEMORADIATION" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Chemoradiation is a possible next treatment for stage 2 and 3 rectal cancers</data>
      <data key="d8">RECTAL CANCER</data>
    </edge>
    <edge source="RECTAL CANCER" target="CHEMOTHERAPY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Chemotherapy regimens are used to treat rectal cancer</data>
      <data key="d8">RECTAL CANCER</data>
    </edge>
    <edge source="RECTAL CANCER" target="LABORATORY TESTING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Laboratory testing detects cancer in tissue and lymph nodes removed during surgery</data>
      <data key="d8">RECTAL CANCER</data>
    </edge>
    <edge source="RECTAL CANCER" target="PATHOLOGIST" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">A pathologist assesses how far the rectal cancer has grown and whether removed lymph nodes contain cancer</data>
      <data key="d8">RECTAL CANCER</data>
    </edge>
    <edge source="RECTAL CANCER" target="STAGE 2 RECTAL CANCER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Rectal cancer can be assigned stage 2 when the tumor has grown through the rectal wall</data>
      <data key="d8">RECTAL CANCER</data>
    </edge>
    <edge source="RECTAL CANCER" target="STAGE 3 RECTAL CANCER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Rectal cancer can be assigned stage 3 when cancer has spread to nearby lymph nodes</data>
      <data key="d8">RECTAL CANCER</data>
    </edge>
    <edge source="SURGICAL STAGING" target="HYSTERECTOMY AND BSO" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Surgical staging is performed during the surgery of hysterectomy and BSO when cancer has not visibly spread, taking samples to check for microscopic metastases</data>
      <data key="d8">HYSTERECTOMY AND BSO</data>
    </edge>
    <edge source="SURGICAL STAGING" target="PATHOLOGIC STAGING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">SURGICAL STAGING and PATHOLOGIC STAGING are closely related terms in cancer staging. Pathologic staging is another name for surgical staging, as both refer to the same process of determining the extent of disease after surgery. Information gained during surgical staging is used to establish the pathologic (post-surgery) stage. Thus, the findings from the surgical procedure directly inform the final pathologic stage, and the two terms are often used interchangeably in clinical practice.</data>
      <data key="d8">SURGICAL STAGING</data>
    </edge>
    <edge source="SURGICAL STAGING" target="PATHOLOGIST" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">A pathologist uses the assessment of removed tissue to assign the cancer stage, a process called surgical staging</data>
      <data key="d8">SURGICAL STAGING</data>
    </edge>
    <edge source="SURGICAL STAGING" target="LABORATORY TESTING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Laboratory testing provides the findings used for surgical staging</data>
      <data key="d8">SURGICAL STAGING</data>
    </edge>
    <edge source="SURGICAL STAGING" target="CHEMOTHERAPY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The cancer stage assigned by surgical staging is used to determine whether chemotherapy is needed</data>
      <data key="d8">SURGICAL STAGING</data>
    </edge>
    <edge source="SURGICAL STAGING" target="CHEMORADIATION" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The cancer stage assigned by surgical staging is used to determine whether chemoradiation is needed</data>
      <data key="d8">SURGICAL STAGING</data>
    </edge>
    <edge source="SURGICAL STAGING" target="GENERAL ANESTHESIA" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">General anesthesia is given during the surgery in which surgical staging samples are taken</data>
      <data key="d8">SURGICAL STAGING</data>
    </edge>
    <edge source="SURGICAL STAGING" target="STAGE 2 RECTAL CANCER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Surgical staging assigns stage 2 when the tumor has grown through the rectal wall and possibly into nearby tissues or organs</data>
      <data key="d8">SURGICAL STAGING</data>
    </edge>
    <edge source="SURGICAL STAGING" target="STAGE 3 RECTAL CANCER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Surgical staging assigns stage 3 when cancer has spread to nearby lymph nodes</data>
      <data key="d8">SURGICAL STAGING</data>
    </edge>
    <edge source="SURGICAL STAGING" target="STAGE 1 RECTAL CANCER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Surgical staging assigns stage 1 when the tumor has grown into the second or third layer of the rectal wall</data>
      <data key="d8">SURGICAL STAGING</data>
    </edge>
    <edge source="SURGICAL STAGING" target="PERITONEAL WASHING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Peritoneal washing is part of surgical staging when there is no fluid buildup in the abdomen</data>
      <data key="d8">SURGICAL STAGING</data>
    </edge>
    <edge source="SURGICAL STAGING" target="EXTRA IMAGING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Surgical staging and extra imaging are two approaches used to determine whether lymph nodes contain cancer</data>
      <data key="d8">SURGICAL STAGING</data>
    </edge>
    <edge source="BREAST CANCER STAGING" target="PATHOLOGIC STAGING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Breast cancer staging includes pathologic staging after surgery</data>
      <data key="d8">PATHOLOGIC STAGING</data>
    </edge>
    <edge source="FIGO" target="PRE-TREATMENT SURGICAL STAGING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The FIGO system is used for staging cervical cancer before treatment</data>
      <data key="d8">PRE-TREATMENT SURGICAL STAGING</data>
    </edge>
    <edge source="INTERNATIONAL FEDERATION OF GYNECOLOGY AND OBSTETRICS" target="PATHOLOGIC STAGING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The International Federation of Gynecology and Obstetrics developed the other staging system for ovarian cancer, which is used most often</data>
      <data key="d8">PATHOLOGIC STAGING</data>
    </edge>
    <edge source="LABORATORY TESTING" target="PATHOLOGIC STAGING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Laboratory testing is used to assign the pathologic stage</data>
      <data key="d8">PATHOLOGIC STAGING</data>
    </edge>
    <edge source="NPC STAGING" target="BIOMARKER TESTING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Biomarker testing is part of nasopharyngeal carcinoma staging to see if the cancer has genes or mutations suggesting treatment.</data>
      <data key="d8">BIOMARKER TESTING</data>
    </edge>
    <edge source="NPC STAGING" target="TNM SCORES" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">NPC staging includes TNM scores and biomarker status.</data>
      <data key="d8">NPC STAGING</data>
    </edge>
    <edge source="HEREDITARY GENE TESTING" target="MUTATION" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Hereditary gene testing looks for inherited mutations in cancer risk genes.</data>
      <data key="d8">HEREDITARY GENE TESTING</data>
    </edge>
    <edge source="GENETIC CANCER RISK TESTING" target="GERMLINE MUTATION" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Genetic cancer risk testing looks for germline mutations inherited from birth parents.</data>
      <data key="d8">GENETIC CANCER RISK TESTING</data>
    </edge>
    <edge source="U.S. FOOD AND DRUG ADMINISTRATION" target="NATIONAL CANCER INSTITUTE" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Both are U.S. organizations involved in the clinical trial process: NCI helps patients find trials, and FDA approves treatments found safe and effective in trials.</data>
      <data key="d8">NATIONAL CANCER INSTITUTE</data>
    </edge>
    <edge source="FDA" target="NATIONAL CANCER INSTITUTE" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>

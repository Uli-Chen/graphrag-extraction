      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Support groups can be found at your local hospital</data>
      <data key="d8">SUPPORT GROUPS</data>
    </edge>
    <edge source="NCCN FOUNDATION" target="UNITED STATES" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>

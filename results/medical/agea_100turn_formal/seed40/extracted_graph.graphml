    </edge>
    <edge source="TRANSANAL LOCAL EXCISION" target="TRANSABDOMINAL SURGERY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Transabdominal surgery is the preferred next treatment after local excision if high-risk features or a T2 tumor are found.</data>
      <data key="d8">TRANSANAL LOCAL EXCISION</data>
    </edge>
    <edge source="TRANSANAL LOCAL EXCISION" target="PROCTOSCOPY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Proctoscopy is recommended for 5 years after transanal local excision to monitor for recurrence.</data>

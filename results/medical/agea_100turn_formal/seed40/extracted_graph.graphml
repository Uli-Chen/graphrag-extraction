      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Genetic testing can identify inherited mutations that cause hereditary ovarian cancer</data>
      <data key="d8">GENETIC TESTING</data>
    </edge>
    <edge source="GENETIC TESTING" target="HEREDITARY GENE TESTING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Hereditary gene testing is one of the two basic types of genetic testing for prostate cancer care</data>
      <data key="d8">GENETIC TESTING</data>
    </edge>
    <edge source="HEPATITIS B AND HEPATITIS C SCREENING" target="TREATMENT TEAM" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The hepatitis blood test tells the treatment team whether the patient has or had hepatitis B or C.</data>
      <data key="d8">TREATMENT TEAM</data>
    </edge>
    <edge source="HEPATITIS B AND HEPATITIS C SCREENING" target="CANCER TREATMENT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Screening is needed because some cancer treatments can reactivate hepatitis B or hepatitis C and cause liver damage.</data>
      <data key="d8">HEPATITIS B AND HEPATITIS C SCREENING</data>
    </edge>
    <edge source="CANCER DIAGNOSIS" target="TREATMENT TEAM" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">After a cancer diagnosis, the treatment team screens distress as part of the patient's cancer care.</data>
      <data key="d8">TREATMENT TEAM</data>
    </edge>
    <edge source="FAMILY HISTORY" target="GENETIC TESTING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Family history of cancer may lead to genetic testing</data>
      <data key="d8">GENETIC TESTING</data>
    </edge>

    <edge source="CLINICAL TRIAL" target="CARE TEAM" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The care team plays a key role in evaluating whether a clinical trial is appropriate for a patient. They can be consulted directly to determine if a clinical trial might be right for the individual. To make this determination, the care team uses the patient's performance status as a key factor in assessing eligibility for a clinical trial.</data>
      <data key="d8">CARE TEAM</data>
    </edge>

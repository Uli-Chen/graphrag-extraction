    </edge>
    <edge source="HEART TESTS" target="SIDE EFFECTS" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Heart tests may be used to monitor treatment side effects</data>
      <data key="d8">SIDE EFFECTS</data>
    </edge>
    <edge source="HEART TESTS" target="ECHOCARDIOGRAM" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">An echocardiogram is a type of heart test that uses ultrasound, or sound waves, to create pictures of the heart. This non-invasive procedure allows healthcare providers to evaluate the structure and function of the heart, providing detailed information about its chambers, valves, and overall performance. As one of the key heart tests, the echocardiogram helps in diagnosing and monitoring various cardiac conditions by visually assessing how well the heart pumps blood and how its components are working together.</data>
      <data key="d8">ECHOCARDIOGRAM</data>
    </edge>
    <edge source="HEART TESTS" target="TREATMENT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Heart tests may be used to monitor treatment side effects or measure heart function before starting treatment</data>
      <data key="d8">HEART TESTS</data>
    </edge>
    <edge source="HEART TESTS" target="ELECTROCARDIOGRAM (ECG OR EKG)" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">An electrocardiogram is a heart test that records electrical changes, rate, and rhythm</data>
      <data key="d8">HEART TESTS</data>
    </edge>
    <edge source="MEDICAL ONCOLOGIST" target="PHARMACIST" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>

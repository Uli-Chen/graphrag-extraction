    </edge>
    <edge source="RADIATION-INDUCED MENOPAUSE" target="MENOPAUSAL HORMONE THERAPY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Menopausal hormone therapy is used after radiation therapy to lessen side effects of radiation-induced menopause.</data>

      <data key="d8">FATIGUE</data>
    </edge>
    <edge source="EXTERNAL BEAM RADIATION THERAPY" target="RADIATION-INDUCED MENOPAUSE" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">External beam radiation therapy can cause radiation-induced menopause when the ovaries are in the radiation field.</data>

      <data key="d8">NATIONAL CANCER INSTITUTE</data>
    </edge>
    <edge source="FINE-NEEDLE ASPIRATION" target="GENETIC TESTING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Genetic testing can be performed on the biopsy sample obtained by FNA</data>
      <data key="d8">GENETIC TESTING</data>
    </edge>
    <edge source="FINE-NEEDLE ASPIRATION" target="ULTRASOUND" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Ultrasound is usually done at the same time as fine-needle aspiration to help pinpoint suspicious areas.</data>
      <data key="d8">ULTRASOUND</data>
    </edge>
    <edge source="LYNCH SYNDROME" target="GERMLINE TESTING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Lynch syndrome is listed as a factor making germline testing more appropriate.</data>
      <data key="d8">GERMLINE TESTING</data>
    </edge>
    <edge source="LYNCH SYNDROME" target="ADRENAL TUMORS" id="0">
      <data key="d5">related_to</data>

    <edge source="TRANSANAL LOCAL EXCISION" target="SURVEILLANCE" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Surveillance is recommended for 5 years after transanal local excision to check for recurrence.</data>

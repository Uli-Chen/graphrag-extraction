    <edge source="PET SCAN" target="POSITRON EMISSION TOMOGRAPHY (PET)" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">PET scan is a clinical imaging procedure that uses positron emission tomography</data>
      <data key="d8">PET SCAN</data>
    </edge>
    <edge source="PET SCAN" target="PET CT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>

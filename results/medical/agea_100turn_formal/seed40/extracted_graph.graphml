    <edge source="PREMATURE MENOPAUSE" target="HYSTERECTOMY AND BSO" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Surgery that removes both ovaries causes premature menopause if the patient has not already entered menopause</data>
      <data key="d8">PREMATURE MENOPAUSE</data>
    </edge>
    <edge source="PREMATURE MENOPAUSE" target="OVARIES" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Inclusion of the ovaries in radiation can cause premature menopause.</data>

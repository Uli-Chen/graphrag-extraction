      <data key="d6">1.0</data>
      <data key="d7">Diagnostic tests confirm prostate cancer and determine whether it is localized or advanced</data>
      <data key="d8">DIAGNOSTIC TESTS</data>
    </edge>
    <edge source="DIAGNOSTIC TESTS" target="DIAGNOSIS" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Diagnostic tests are used to confirm cancer and support diagnosis</data>
      <data key="d8">DIAGNOSTIC TESTS</data>
    </edge>

      <data key="d8">MUTATION</data>
    </edge>
    <edge source="TESTING" target="PATIENT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The patient undergoes medical testing and should wait for all test results to come in.</data>
      <data key="d8">PATIENT</data>
    </edge>
    <edge source="TESTING" target="PSA TEST" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">A PSA test is one of the common prostate tests used during testing</data>
      <data key="d8">PSA TEST</data>
    </edge>
    <edge source="MYCHART" target="PATIENT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">MyChart is a patient portal that allows patients to access test results, track appointments, and communicate with their care team. A patient may set up MyChart specifically to track appointments and communicate with their care team, thereby gaining access to these features and maintaining ongoing engagement with their healthcare providers.</data>
      <data key="d8">PATIENT</data>
    </edge>
    <edge source="MYCHART" target="PHYSICIAN" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">MyChart (the patient portal) messages are not immediately seen by a physician. Because of this, any urgent concerns should not be sent through MyChart or portal messaging; instead, they should be called directly to triage. Physicians do not monitor MyChart messages in real time, so portal messaging is not appropriate for time-sensitive or urgent medical issues.</data>
      <data key="d8">PHYSICIAN</data>
    </edge>
    <edge source="APPOINTMENTS" target="PATIENT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The patient has appointments that can be tracked in MyChart.</data>
      <data key="d8">PATIENT</data>
    </edge>
    <edge source="EYE EXAM" target="PRIMARY CNS LYMPHOMA" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">An eye exam is performed because primary CNS lymphoma can affect the eyes</data>
      <data key="d8">PRIMARY CNS LYMPHOMA</data>
    </edge>
    <edge source="FERTILITY SPECIALIST" target="FERTILITY COUNSELOR" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Both fertility specialist and fertility counselor are fertility-related experts who can help the patient preserve fertility before or during cancer treatment.</data>
      <data key="d8">FERTILITY SPECIALIST</data>
    </edge>
    <edge source="BETOBACCOFREE" target="PATIENT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">BeTobaccoFree is an online support resource for the patient to quit smoking or vaping</data>
      <data key="d8">PATIENT</data>
    </edge>
    <edge source="BIOMARKER TESTING" target="TARGETED THERAPIES" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Biomarker testing can help determine eligibility for targeted therapies</data>
      <data key="d8">TARGETED THERAPIES</data>
    </edge>

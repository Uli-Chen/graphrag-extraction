      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">BRCA mutations are the most common inherited cause of hereditary ovarian cancer</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="OVARIAN CANCER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">BRCA mutations increase the risk of developing ovarian cancer</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="PROSTATE CANCER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">People with certain inherited genetic mutations are at greater risk for prostate cancer.</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="MAINTENANCE THERAPY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">BRCA status plays an important role in guiding maintenance therapy decisions</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="TUMOR STAGING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Tumor testing helps determine the likelihood of cancer spread and aggressive transformation, which can inform tumor staging</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="METASTASIS" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Tumor testing can use a sample from a metastasis in lymph nodes, bones, liver, lung, or another affected area</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="BIOPSY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">A biopsy of a tumor or metastasis provides the tissue sample used for tumor testing</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="MICROSATELLITE INSTABILITY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Microsatellite instability (MSI) is a condition characterized by the accumulation of genetic alterations in microsatellite regionsshort, repetitive DNA sequences prone to errors during replication. Deficient mismatch repair (dMMR) is a key underlying cause of this instability.</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="MSI-H" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">MSI-H is often due to deficient mismatch repair</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="TMB-H" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Both TMB-H and MSI-H/dMMR are tumor mutation statuses that may guide treatment with immunotherapy drugs.</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="MICROSATELLITE INSTABILITY (MSI)" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">MSI-H is high microsatellite instability, often due to dMMR genes, and is part of the MSI-H/dMMR tumor mutation status.</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="DEFICIENT MISMATCH REPAIR (DMMR)" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Deficient mismatch repair prevents DNA errors from being fixed, leading to microsatellite instability.</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="TUMOR MUTATIONAL BURDEN (TMB)" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">TMB-H is defined as a tumor mutational burden of 10 or more mutations per million base pairs.</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="BIOMARKER TESTING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Biomarker testing identifies the presence or absence of mutations</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="BIOMARKER TUMOR TESTING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Biomarker tumor testing is another term for biomarker testing</data>
      <data key="d8">MUTATION</data>
    </edge>

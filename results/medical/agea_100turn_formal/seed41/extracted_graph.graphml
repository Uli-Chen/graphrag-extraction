    <edge source="GERMLINE TESTING" target="GENETIC COUNSELING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Genetic counseling helps a patient decide whether to have germline testing</data>

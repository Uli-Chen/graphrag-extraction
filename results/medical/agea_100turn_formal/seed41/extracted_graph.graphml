      <data key="d8">INTRAVESICAL BCG THERAPY</data>
    </edge>
    <edge source="BCG THERAPY" target="INTRAVESICAL CHEMOTHERAPY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>

    <edge source="OVARIES" target="RADIATION FIELD" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">When ovaries are included in the radiation field, it causes premature menopause.</data>
      <data key="d8">OVARIES</data>
    </edge>
    <edge source="OVARIAN TISSUE BANKING" target="OVARIAN TRANSPOSITION" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Both ovarian tissue banking and ovarian transposition are described as fertility preservation options for people who may want children after treatment.</data>
      <data key="d8">OVARIAN TISSUE BANKING</data>
    </edge>
    <edge source="OVARIAN TISSUE BANKING" target="FERTILITY COUNSELING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Fertility counseling discusses fertility preservation options, including ovarian tissue banking.</data>
      <data key="d8">OVARIAN TISSUE BANKING</data>
    </edge>
    <edge source="OVARY PRESERVATION" target="SURGICAL MENOPAUSE" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Preserving the ovaries during hysterectomy prevents surgical menopause from removal of both ovaries.</data>
      <data key="d8">OVARY PRESERVATION</data>
    </edge>
    <edge source="OVARY PRESERVATION" target="MENOPAUSE" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Preserving the ovaries prevents the sudden drop in estrogen that would cause menopause.</data>
      <data key="d8">OVARY PRESERVATION</data>
    </edge>
    <edge source="OVARIAN TRANSPOSITION" target="OVARIES" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Ovarian transposition moves one or both ovaries out of the radiation beam range.</data>
      <data key="d8">OVARIES</data>
    </edge>
    <edge source="OVARIAN TRANSPOSITION" target="RADIATION-INDUCED MENOPAUSE" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Ovarian transposition may reduce or prevent radiation-induced menopause.</data>
      <data key="d8">RADIATION-INDUCED MENOPAUSE</data>
    </edge>
    <edge source="PREMATURE MENOPAUSE" target="OVARIES" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>

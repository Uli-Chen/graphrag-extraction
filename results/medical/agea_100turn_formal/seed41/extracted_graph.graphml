    <edge source="MUTATION" target="PATIENT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The patient may carry inherited or acquired mutations relevant to cancer risk.</data>
      <data key="d8">PATIENT</data>
    </edge>
    <edge source="MUTATION" target="CANCER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Cancer begins with mutations in genes. These genetic mutations can cause cancer by disrupting normal cell regulation. Tumor tests can identify specific mutations, and those mutations can then be targeted with specific therapies.</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="BLADDER CANCER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Bladder cancer starts with mutations in genes</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="AML" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Mutations are unique to AML cells and detected by mutation testing</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="DEFICIENT MISMATCH REPAIR" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Deficient mismatch repair arises when DNA mutations prevent mismatch repair proteins from fixing errors.</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="MSI-H/DMMR MUTATION" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">MSI-H/dMMR mutation is a type of mutation</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="GERMLINE MUTATION" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">A germline mutation is an inherited type of mutation.</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="SOMATIC MUTATION" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">A somatic mutation is an acquired type of mutation.</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="TUMOR MUTATION TESTING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Tumor mutation testing detects DNA mutations in tumor samples.</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="TUMOR MUTATIONAL BURDEN-HIGH" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">TMB-H is defined by a high number of mutations per million base pairs of tumor DNA.</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="GENETIC TESTING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Genetic testing identifies mutations in genes</data>
      <data key="d8">MUTATION</data>
    </edge>

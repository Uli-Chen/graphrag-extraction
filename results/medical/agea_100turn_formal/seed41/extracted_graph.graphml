      <data key="d7">The FIGO system is used to stage cervical cancer</data>
      <data key="d8">INTERNATIONAL FEDERATION OF GYNECOLOGY AND OBSTETRICS</data>
    </edge>
    <edge source="INTERNATIONAL FEDERATION OF GYNECOLOGY AND OBSTETRICS" target="STAGING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>

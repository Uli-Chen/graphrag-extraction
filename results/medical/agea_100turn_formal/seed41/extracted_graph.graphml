      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">A chromosome translocation is a chromosomal mutation or abnormality</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="GENE REARRANGEMENT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">A gene rearrangement is a genetic mutation or abnormality</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="LEUKEMIA PREDISPOSITION SYNDROMES" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Predisposition syndromes are linked to inherited genetic mutations that raise leukemia risk</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="CLL" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">DNA sequencing is a biomarker test used for CLL cells.</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="ACUTE MYELOID LEUKEMIA" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Specific gene mutations can support a diagnosis of AML even when blast count is below 20%</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="EWING SARCOMA" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The gene fusions in Ewing sarcoma result from somatic mutation or errors of cell division, not from inherited mutations.</data>
      <data key="d8">MUTATION</data>
    </edge>

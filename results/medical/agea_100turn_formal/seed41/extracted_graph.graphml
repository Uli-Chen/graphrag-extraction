      <data key="d8">MRI</data>
    </edge>
    <edge source="MRI" target="OPEN MRI" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Open MRI is a type of MRI with a magnetic top and bottom</data>
      <data key="d8">MRI</data>
    </edge>
    <edge source="MRI" target="FERTILITY-SPARING TREATMENT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">MRI of the pelvis is recommended 6 months after fertility-sparing surgery and yearly for 2 to 3 years.</data>
      <data key="d8">MRI</data>
    </edge>

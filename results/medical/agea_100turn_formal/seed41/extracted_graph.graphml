      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Biomarker testing of cervical cancer tumors is recommended to guide targeted therapy, especially if the cancer recurs.</data>
      <data key="d8">CERVICAL CANCER</data>
    </edge>
    <edge source="BIOMARKER TESTING" target="BRCA MUTATION" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">BRCA mutation is a biomarker specifically tested to guide treatment decisions.</data>
      <data key="d8">BRCA MUTATION</data>
    </edge>
    <edge source="BIOMARKER TESTING" target="TUMOR MUTATION TESTING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Tumor mutation testing is closely related to biomarker testing and molecular profiling.</data>
      <data key="d8">TUMOR MUTATION TESTING</data>

      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Diagnostic tests include imaging scans, biopsies, and genetic tests; imaging tests are a type of diagnostic test</data>
      <data key="d8">DIAGNOSTIC TESTS</data>
    </edge>

    </edge>
    <edge source="UNITED STATES" target="BCG THERAPY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The United States is one of the countries where BCG therapy has been in short supply for several years.</data>

      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="MISMATCH REPAIR" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">MMR is tested as a biomarker in recurrent ovarian cancer.</data>
      <data key="d8">MUTATION</data>
    </edge>

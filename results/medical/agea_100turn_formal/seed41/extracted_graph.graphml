      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">A brain MRI scan is an MRI scan focused on the brain</data>
      <data key="d8">MRI (MAGNETIC RESONANCE IMAGING) SCAN</data>
    </edge>
    <edge source="BREAST MRI" target="MAMMOGRAM" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">A breast MRI may be used in addition to a mammogram</data>
      <data key="d8">MAMMOGRAM</data>
    </edge>
    <edge source="PELVIC MAGNETIC RESONANCE IMAGING" target="CT OF THE CHEST AND ABDOMEN" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Both are imaging tests used in rectal cancer staging: pelvic MRI shows extent in the rectum and nearby lymph nodes, and chest/abdomen CT checks for spread to the liver, lungs, or other organs.</data>
      <data key="d8">CT OF THE CHEST AND ABDOMEN</data>
    </edge>
    <edge source="TECHNOLOGIST" target="MRI" id="0">
      <data key="d5">related_to</data>

      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">DNA mutations are changes in the DNA of cervical cells that make the cells abnormal.</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="GENE MUTATIONS" id="0">
      <data key="d5">related_to</data>

      <data key="d6">1.0</data>
      <data key="d7">Genetic testing can detect germline mutations relevant to cancer risk.</data>
      <data key="d8">GENETIC TEST</data>
    </edge>
    <edge source="GENETIC TEST" target="SOMATIC MUTATION" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>

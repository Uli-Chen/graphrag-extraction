    <edge source="NCCN" target="IMMUNOTHERAPY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The National Comprehensive Cancer Network (NCCN) offers patient education materials that describe immunotherapy as a type of systemic therapy. In its patient guidelines, NCCN provides detailed information on immunotherapy, including its side effects and the use of checkpoint inhibitors.</data>
      <data key="d8">NCCN</data>
    </edge>

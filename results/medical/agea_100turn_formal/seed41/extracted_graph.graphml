      <data key="d6">1.0</data>
      <data key="d7">Specific gene mutations can support a diagnosis of AML even when blast count is below 20%</data>
      <data key="d8">GENE MUTATIONS</data>
    </edge>
    <edge source="ACUTE MYELOID LEUKEMIA" target="ABNORMAL CHROMOSOMES" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Abnormal chromosomes can support a diagnosis of AML even when blast count is below 20%</data>
      <data key="d8">ABNORMAL CHROMOSOMES</data>
    </edge>
    <edge source="ACUTE MYELOID LEUKEMIA" target="PROGNOSIS" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Prognosis refers to the likely course of the patient's AML</data>
      <data key="d8">PROGNOSIS</data>
    </edge>
    <edge source="BIOMARKER TESTS" target="SURVEILLANCE" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Biomarker tests are sometimes used for surveillance in people treated for non-muscleinvasive bladder cancer</data>
      <data key="d8">SURVEILLANCE</data>
    </edge>
    <edge source="BIOMARKER TESTS" target="URINE TESTS FOR TUMOR MARKERS" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Urine tests for tumor markers are a type of biomarker test that detects tumor cells or markers in urine</data>
      <data key="d8">BIOMARKER TESTS</data>
    </edge>
    <edge source="HIGH-DOSE CHEMOTHERAPY" target="FATIGUE" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">High-dose chemotherapy makes patients feel very fatigued</data>
      <data key="d8">FATIGUE</data>
    </edge>
    <edge source="HIGH-DOSE CHEMOTHERAPY" target="INFECTIONS" id="0">

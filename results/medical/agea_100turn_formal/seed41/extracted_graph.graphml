      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The doctor explains medical information, including treatment plans, and should be asked for simpler terms when needed.</data>
      <data key="d8">TREATMENT</data>
    </edge>
    <edge source="TREATMENT" target="BLADDER CANCER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Treatment is provided for bladder cancer</data>

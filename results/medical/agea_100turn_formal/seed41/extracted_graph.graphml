      <data key="d8">INDIANA</data>
    </edge>
    <edge source="INDIANA UNIVERSITY" target="INDIANA" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Indiana University is associated with the geographic entity Indiana, and the Indiana pouch was developed by surgeons at Indiana University.</data>
      <data key="d8">INDIANA</data>
    </edge>
    <edge source="PATHOLOGIC STAGING" target="SURGERY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">PATHOLOGIC STAGING is the process of determining the extent of disease by examining tissue that has been removed during SURGERY. This staging method relies on the analysis of surgical specimens, as the tissue obtained through the surgical procedure provides the material necessary for pathologic evaluation.</data>
      <data key="d8">SURGERY</data>
    </edge>
    <edge source="PATHOLOGIC STAGING" target="HYSTERECTOMY AND BSO" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Information gained during surgery contributes to determining the pathologic stage of ovarian cancer</data>
      <data key="d8">HYSTERECTOMY AND BSO</data>
    </edge>
    <edge source="BLUE LIGHT CYSTOSCOPY" target="NARROW-BAND IMAGING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Both are newer detection techniques compared with white light cystoscopy and are still in the testing phase</data>
      <data key="d8">BLUE LIGHT CYSTOSCOPY</data>
    </edge>
    <edge source="WHITE LIGHT CYSTOSCOPY" target="BLUE LIGHT CYSTOSCOPY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Blue light cystoscopy may identify tumors more distinctly than standard white light cystoscopy</data>
      <data key="d8">BLUE LIGHT CYSTOSCOPY</data>
    </edge>
    <edge source="WHITE LIGHT CYSTOSCOPY" target="NARROW-BAND IMAGING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Narrow-band imaging may detect tumors better than standard white light cystoscopy</data>
      <data key="d8">WHITE LIGHT CYSTOSCOPY</data>
    </edge>
    <edge source="URINE CYTOLOGY" target="CYSTOSCOPY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">A urine sample can be collected during cystoscopy; if urine cytology finds abnormal cells, a cystoscopy is needed to locate cancer in the urethra or bladder</data>
      <data key="d8">CYSTOSCOPY</data>
    </edge>
    <edge source="URINE CYTOLOGY" target="BIOPSY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Abnormal urine cytology may lead to cystoscopy and biopsy to locate and test suspicious areas in the urinary tract</data>
      <data key="d8">URINE CYTOLOGY</data>
    </edge>
    <edge source="URINE CYTOLOGY" target="URINE TESTS FOR TUMOR MARKERS" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Both are urine-based tests used to look for signs of cancer in the urine</data>
      <data key="d8">URINE CYTOLOGY</data>
    </edge>
    <edge source="WHITE LIGHT" target="CYSTOSCOPY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">White light is the standard light used during cystoscopy for tumor detection.</data>
      <data key="d8">CYSTOSCOPY</data>
    </edge>
    <edge source="WHITE LIGHT" target="BLUE LIGHT CYSTOSCOPY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Blue light cystoscopy is a newer method that may detect tumors better than standard white light detection.</data>
      <data key="d8">BLUE LIGHT CYSTOSCOPY</data>
    </edge>
    <edge source="CYSTECTOMY" target="RADICAL CYSTECTOMY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Radical cystectomy is a type of cystectomy that removes the entire bladder along with nearby lymph nodes and possibly other organs.</data>
      <data key="d8">CYSTECTOMY</data>
    </edge>
    <edge source="CYSTECTOMY" target="PARTIAL CYSTECTOMY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Partial cystectomy is a type of cystectomy that removes part of the bladder.</data>
      <data key="d8">CYSTECTOMY</data>
    </edge>
    <edge source="URGENCY TO URINATE" target="BLADDER CANCER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Urgency to urinate is a symptom of bladder cancer</data>
      <data key="d8">URGENCY TO URINATE</data>
    </edge>
    <edge source="PAINFUL URINATION" target="BLADDER CANCER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Painful urination is a symptom of bladder cancer</data>
      <data key="d8">PAINFUL URINATION</data>
    </edge>
    <edge source="BLADDER REMOVAL" target="CYSTECTOMY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Bladder removal is another name for cystectomy.</data>
      <data key="d8">CYSTECTOMY</data>
    </edge>
    <edge source="NARROW-BAND IMAGING" target="CYSTOSCOPY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Narrow-band imaging can be used during cystoscopy to improve tumor detection.</data>
      <data key="d8">CYSTOSCOPY</data>
    </edge>
    <edge source="NARROW-BAND IMAGING" target="BLUE LIGHT CYSTOSCOPY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Both are relatively new imaging methods being tested for bladder tumor detection.</data>
      <data key="d8">BLUE LIGHT CYSTOSCOPY</data>
    </edge>
    <edge source="NARROW-BAND IMAGING" target="WHITE LIGHT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Narrow-band imaging is a newer method that may detect tumors better than standard white light detection.</data>
      <data key="d8">WHITE LIGHT</data>
    </edge>
    <edge source="RADICAL CYSTECTOMY" target="URINARY DIVERSION" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Radical cystectomy is a surgical procedure that involves the removal of the bladder. Urinary diversion is a complementary surgical procedure performed at the same time as radical cystectomy, designed to provide a new way for urine to leave the body. Together, these procedures ensure that, after the bladder is removed, a functional pathway for urine excretion is established. Urinary diversion is thus an integral part of the overall surgical management when radical cystectomy is performed.</data>
      <data key="d8">RADICAL CYSTECTOMY</data>
    </edge>
    <edge source="RADICAL CYSTECTOMY" target="BLADDER REMOVAL SURGERY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Radical cystectomy is the most widely used surgery for muscle-invasive bladder cancer and is a form of bladder removal surgery.</data>
      <data key="d8">RADICAL CYSTECTOMY</data>
    </edge>
    <edge source="PROCTOSCOPY" target="TESTING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Proctoscopy is a testing procedure used to look for signs of cancer in the bowel</data>
      <data key="d8">PROCTOSCOPY</data>
    </edge>
    <edge source="PROCTOSCOPY" target="COLONOSCOPY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Both are endoscopic surveillance procedures recommended after transanal local excision; proctoscopy is more frequent and colonoscopy is done at longer intervals</data>
      <data key="d8">PROCTOSCOPY</data>
    </edge>
    <edge source="TUMOR REMOVAL" target="SURVEILLANCE" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Surveillance is watching to see if cancer comes back after it has been treated or removed, so it is directly connected to post-removal monitoring.</data>
      <data key="d8">TUMOR REMOVAL</data>
    </edge>
    <edge source="TUMOR REMOVAL" target="TURBT" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">TURBT is a type of tumor removal; it removes tumors through the urethra while leaving the rest of the bladder in place.</data>
      <data key="d8">TUMOR REMOVAL</data>
    </edge>
    <edge source="EXAMINATIONS UNDER ANESTHESIA" target="CYSTOSCOPY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Cystoscopy is one of the examinations that can be performed under anesthesia</data>
      <data key="d8">CYSTOSCOPY</data>
    </edge>
    <edge source="EXAMINATIONS UNDER ANESTHESIA" target="PROCTOSCOPY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Proctoscopy is one of the examinations that can be performed under anesthesia.</data>
      <data key="d8">EXAMINATIONS UNDER ANESTHESIA</data>
    </edge>

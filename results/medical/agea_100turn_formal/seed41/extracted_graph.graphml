      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Perineural invasion is a high-risk feature that increases the risk of cancer returning after treatment.</data>
      <data key="d8">LOCAL RECURRENCE</data>
    </edge>
    <edge source="COMPLETE REMISSION" target="ANAL CANCER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Anal cancer can be classified as being in complete remission when no signs of cancer are found</data>
      <data key="d8">ANAL CANCER</data>
    </edge>
    <edge source="COMPLETE REMISSION" target="PERSISTENT DISEASE" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Persistent disease may go into complete remission after monitoring for up to 6 months</data>
      <data key="d8">COMPLETE REMISSION</data>
    </edge>
    <edge source="TNM SCORING" target="METASTASIS" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The M component of TNM scoring indicates whether the cancer has metastasized to distant sites.</data>
      <data key="d8">METASTASIS</data>
    </edge>
    <edge source="TNM SCORING" target="CANCER STAGING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">TNM scores are assigned as part of cancer staging and are then combined to assign a numbered stage.</data>
      <data key="d8">METASTASIS</data>
    </edge>
    <edge source="METASTATIC LIVER CANCER" target="LIVER CANCER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Liver cancer can spread to distant sites such as the lung or bone, becoming metastatic liver cancer.</data>
      <data key="d8">LIVER CANCER</data>
    </edge>
    <edge source="TNM SCORES" target="METASTASIS" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Metastasis is the M category in TNM scores.</data>
      <data key="d8">METASTASIS</data>
    </edge>
    <edge source="BONE SCAN" target="METASTASIS" id="0">
      <data key="d5">related_to</data>

      <data key="d8">NATIONAL COALITION FOR CANCER SURVIVORSHIP</data>
    </edge>
    <edge source="DNA MUTATIONS" target="CERVICAL DYSPLASIA" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>

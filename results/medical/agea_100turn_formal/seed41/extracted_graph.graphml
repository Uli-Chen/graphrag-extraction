      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Mutations in DNA cause cervical cells to become abnormal; these abnormal changes are known as cervical dysplasia.</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="IMMUNE CHECKPOINT INHIBITOR THERAPY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Metastatic or unresectable TMB-H cancers are often treated with immunotherapy drugs targeting PD-1 or PD-L1.</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="TUMOR TESTING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Tumor testing looks for specific abnormalities and mutations in DNA repair genes</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="GENETIC TEST" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">A genetic test is used to find abnormal changes (mutations) in genes.</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="GERMLINE TESTING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Germline testing looks for inherited germline mutations in genes.</data>
      <data key="d8">MUTATION</data>
    </edge>
    <edge source="MUTATION" target="HEREDITARY GENE TESTING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Hereditary gene testing looks for inherited mutations in cancer risk genes</data>
      <data key="d8">MUTATION</data>
    </edge>

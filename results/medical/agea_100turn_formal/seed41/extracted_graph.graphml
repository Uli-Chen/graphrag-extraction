      <data key="d7">NCCN's patient education chapter lists supportive care as a treatment option for bladder cancer.</data>
      <data key="d8">SUPPORTIVE CARE</data>
    </edge>
    <edge source="NCCN" target="NCCN GUIDELINES FOR PATIENTS: DISTRESS DURING CANCER CARE" id="0">

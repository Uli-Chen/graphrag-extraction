      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Primary CNS lymphoma is a cancer of lymphocytes</data>
      <data key="d8">CANCER</data>
    </edge>
    <edge source="CANCER" target="PET SCAN" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">PET scans use a tracer to see where cancer cells are in the body and how much sugar they take up</data>
      <data key="d8">CANCER</data>
    </edge>
    <edge source="CANCER" target="CANCER STAGING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Cancer staging is used to reflect prognosis and guide treatment decisions for cancer.</data>
      <data key="d8">CANCER</data>
    </edge>

    <edge source="SURVEILLANCE" target="DIGITAL RECTAL EXAM" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">DREs every 3 to 6 months for 5 years are part of surveillance after lymph node-only treatment</data>
      <data key="d8">SURVEILLANCE</data>
    </edge>
    <edge source="SURVEILLANCE" target="IMAGING TEST" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Imaging tests may be ordered if recurrence or spread is suspected and are used in surveillance when indicated.</data>
      <data key="d8">SURVEILLANCE</data>
    </edge>
    <edge source="SURVEILLANCE" target="ANOSCOPY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Surveillance and anoscopy are closely related in post-treatment monitoring. Anoscopy is a recommended component of surveillance protocols when feasible. Specifically, after lymph node-only treatment, surveillance includes anoscopy performed every 6 to 12 months for a period of 3 years. Thus, the surveillance strategy incorporates regular anoscopic examinations to monitor for potential recurrence or complications, with the frequency and duration clearly defined in the context of lymph node-only treatment.</data>
      <data key="d8">SURVEILLANCE</data>
    </edge>
    <edge source="SURVEILLANCE" target="PROCTOSCOPY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Proctoscopy is a surveillance examination performed after transanal local excision</data>
      <data key="d8">SURVEILLANCE</data>
    </edge>
    <edge source="SURVEILLANCE" target="COMPLETE REMISSION" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">A complete remission result leads to the recommended surveillance schedule described in the text</data>
      <data key="d8">SURVEILLANCE</data>
    </edge>
    <edge source="SURVEILLANCE" target="COLONOSCOPY" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Colonoscopy is part of surveillance after transanal local excision, with intervals based on prior results</data>
      <data key="d8">SURVEILLANCE</data>
    </edge>
    <edge source="SURVEILLANCE" target="DIGITAL RECTAL EXAMINATION" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Digital rectal examination is a recommended component of surveillance after treatment</data>
      <data key="d8">SURVEILLANCE</data>
    </edge>
    <edge source="SURVEILLANCE" target="LYMPH NODE EXAM" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Surveillance includes regular inguinal lymph node examinations as a recommended component. Specifically, these exams are advised every 3 to 6 months for a period of 5 years.</data>
      <data key="d8">SURVEILLANCE</data>
    </edge>
    <edge source="SURVEILLANCE" target="FOLLOW-UP TESTING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Follow-up testing after treatment is the surveillance process to find new cancer growth early.</data>
      <data key="d8">SURVEILLANCE</data>
    </edge>
    <edge source="SURVEILLANCE" target="CEA BLOOD TEST" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">CEA blood tests are used in surveillance for stage 2 and 3 colon cancer.</data>
      <data key="d8">SURVEILLANCE</data>
    </edge>
    <edge source="SURVEILLANCE" target="CANCER PROGRESSION" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Surveillance and testing aim to detect cancer progression or relapse early.</data>
      <data key="d8">SURVEILLANCE</data>
    </edge>
    <edge source="SURVEILLANCE" target="PHYSICAL EXAMS" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Physical exams are an important part of surveillance after cervical cancer treatment</data>
      <data key="d8">SURVEILLANCE</data>
    </edge>
    <edge source="SURVEILLANCE" target="FOLLOW-UP VISITS" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Surveillance is carried out during scheduled follow-up visits</data>
      <data key="d8">SURVEILLANCE</data>
    </edge>
    <edge source="SURVEILLANCE" target="FOLLOW-UP IMAGING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Follow-up imaging is part of surveillance after treatment</data>
      <data key="d8">SURVEILLANCE</data>
    </edge>
    <edge source="SURVEILLANCE" target="PHYSICAL AND PELVIC EXAMS" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Surveillance includes regular physical and pelvic exams.</data>
      <data key="d8">SURVEILLANCE</data>
    </edge>
    <edge source="SURVEILLANCE" target="BLOOD AND IMAGING TESTS" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Surveillance may include blood and imaging tests if relapse is suspected.</data>
      <data key="d8">SURVEILLANCE</data>
    </edge>

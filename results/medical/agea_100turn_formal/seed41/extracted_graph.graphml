      <data key="d8">CANCER</data>
    </edge>
    <edge source="CANCER" target="GENETIC TESTING" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Genetic testing is suggested to find out if a person has inherited cancer risk</data>
      <data key="d8">CANCER</data>

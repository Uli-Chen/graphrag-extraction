      <data key="d8">MATURE B-CELL ALL (BURKITT LEUKEMIA)</data>
    </edge>
    <edge source="CHRONIC MYELOID LEUKEMIA" target="BCR::ABL1" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">BCR::ABL1 produces a protein that leads to uncontrolled blood cell growth, ultimately causing CML.</data>
      <data key="d8">BCR::ABL1</data>
    </edge>
    <edge source="CHRONIC MYELOID LEUKEMIA" target="PHILADELPHIA CHROMOSOME" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">The Philadelphia chromosome is the hallmark of CML; if it is absent, CML is not present.</data>

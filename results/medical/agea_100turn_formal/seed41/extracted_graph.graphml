      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Digital rectal examination and anoscopy are recommended together during the follow-up exam.</data>
      <data key="d8">ANOSCOPY</data>
    </edge>
    <edge source="FOLLOW-UP TESTING AND SURVEILLANCE" target="PHYSICAL EXAM" id="0">

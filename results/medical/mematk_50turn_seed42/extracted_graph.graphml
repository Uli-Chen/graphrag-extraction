      <data key="d12">HYSTERECTOMY AND BSO</data>
    </edge>
    <edge source="BLOOD THINNERS" target="HYSTERECTOMY AND BSO" id="related_to">
      <data key="d7">BLOOD THINNERS</data>
      <data key="d8">HYSTERECTOMY AND BSO</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Many patients are placed on blood thinners for up to 4 weeks after hysterectomy and BSO to help prevent blood clots</data>
      <data key="d12">HYSTERECTOMY AND BSO</data>
    </edge>
    <edge source="DEEP VEIN THROMBOSIS" target="HYSTERECTOMY AND BSO" id="related_to">
      <data key="d7">DEEP VEIN THROMBOSIS</data>
      <data key="d8">HYSTERECTOMY AND BSO</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Recent abdominal surgery is a risk factor for developing deep vein thrombosis, so surgery patients are monitored for blood clots</data>

      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">A pathologist performs pathologic staging based on findings from removed tissue and lymph nodes</data>
      <data key="d12">PATHOLOGIST</data>
    </edge>
    <edge source="PATHOLOGIC STAGING" target="SURGERY" id="related_to">
      <data key="d7">PATHOLOGIC STAGING</data>
      <data key="d8">SURGERY</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">PATHOLOGIC STAGING is the process of determining the extent of disease by examining tissue that has been removed during SURGERY. This staging method relies on the analysis of surgical specimens, as the tissue obtained through the surgical procedure provides the material necessary for pathologic evaluation.</data>
      <data key="d12">PATHOLOGIC STAGING</data>
    </edge>

    <edge source="GENETIC TEST" target="MUTATION" id="related_to">
      <data key="d7">GENETIC TEST</data>
      <data key="d8">MUTATION</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">A genetic test is used to find abnormal changes (mutations) in genes.</data>

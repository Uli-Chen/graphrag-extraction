    <edge source="NCCN" target="NCCN GUIDELINES FOR PATIENTS" id="related_to">
      <data key="d7">NCCN</data>
      <data key="d8">NCCN GUIDELINES FOR PATIENTS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">NCCN publishes the NCCN Guidelines for Patients</data>

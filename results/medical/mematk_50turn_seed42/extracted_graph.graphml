      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Molecular biomarker testing is one of the two basic types of genetic tests used for prostate cancer care.</data>
      <data key="d12">GENETIC TEST</data>
    </edge>

      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Pathologic staging is also referred to as surgical staging and is also known as the surgical stage.</data>
      <data key="d12">PATHOLOGIC STAGING</data>
    </edge>
    <edge source="PREMATURE MENOPAUSE" target="HYSTERECTOMY AND BSO" id="related_to">
      <data key="d7">PREMATURE MENOPAUSE</data>
      <data key="d8">HYSTERECTOMY AND BSO</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>

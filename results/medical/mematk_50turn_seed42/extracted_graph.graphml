    <edge source="BIOPSY" target="PATHOLOGIST" id="related_to">
      <data key="d7">BIOPSY</data>
      <data key="d8">PATHOLOGIST</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">A pathologist is a medical professional who receives biopsy samplestissue specimens obtained from a patientand analyzes them to determine whether cancer is present. In the course of this work, the pathologist examines biopsy core samples under a microscope, carefully looking for cancer cells. The pathologist also performs additional tests on the biopsy samples as needed to support the diagnosis. Altogether, the pathologists role involves receiving, examining, and testing biopsy samples to identify cancerous changes and provide an accurate diagnosis.</data>
      <data key="d12">PATHOLOGIST</data>
    </edge>
    <edge source="BIOPSY" target="STEREOTACTIC BIOPSY" id="related_to">

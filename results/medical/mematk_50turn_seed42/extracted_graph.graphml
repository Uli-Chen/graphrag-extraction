    <edge source="LABORATORY TESTING" target="PATHOLOGIC STAGING" id="related_to">
      <data key="d7">LABORATORY TESTING</data>
      <data key="d8">PATHOLOGIC STAGING</data>
      <data key="d9">related_to</data>

    <edge source="BIOPSY" target="MEDICAL PROCEDURE" id="related_to">
      <data key="d7">BIOPSY</data>
      <data key="d8">MEDICAL PROCEDURE</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>

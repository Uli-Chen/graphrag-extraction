    <edge source="NEUROPATHOLOGIST" target="TREATMENT TEAM" id="related_to">
      <data key="d7">NEUROPATHOLOGIST</data>
      <data key="d8">TREATMENT TEAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Neuropathologist findings and diagnostic information help the treatment team plan treatment.</data>
      <data key="d12">NEUROPATHOLOGIST</data>
    </edge>

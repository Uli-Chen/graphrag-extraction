    <edge source="LABORATORY TESTING" target="PATHOLOGIST" id="related_to">
      <data key="d7">LABORATORY TESTING</data>
      <data key="d8">PATHOLOGIST</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">A pathologist examines tissue and lymph nodes sent for laboratory testing</data>

      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Platinum-based chemotherapy is commonly recommended for use in conjunction with radiation therapy, particularly when systemic therapy is planned.</data>
      <data key="d8">PLATINUM-BASED CHEMOTHERAPY</data>
    </edge>
    <edge source="PLATINUM-BASED CHEMOTHERAPY" target="METASTATIC CERVICAL CANCER" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Platinum-based chemotherapy is utilized as a systemic therapy for metastatic cervical cancer, often administered as a combination regimen.</data>
      <data key="d8">PLATINUM-BASED CHEMOTHERAPY</data>
    </edge>
    <edge source="EBRT" target="CANCEROUS LESIONS" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">EBRT is a local treatment for cancerous lesions that delivers radiation from outside the body to a targeted area, such as the pelvis or a larger field.</data>
      <data key="d8">EBRT</data>
    </edge>

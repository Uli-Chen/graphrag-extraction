      <data key="d8">COLORECTAL CANCER SCREENING</data>
    </edge>
    <edge source="MISMATCH REPAIR TESTING" target="LYNCH SYNDROME" id="0">
      <data key="d5">related_to</data>
      <data key="d6">1.0</data>
      <data key="d7">Relation type: leads to testing for If colon cancer is dMMR/MSI-H, mismatch repair testing leads to testing for Lynch syndrome.</data>
      <data key="d8">LYNCH SYNDROME</data>
    </edge>

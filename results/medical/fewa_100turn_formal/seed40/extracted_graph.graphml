    <edge source="ACUTE LYMPHOBLASTIC LEUKEMIA" target="ADOLESCENT AND YOUNG ADULT" id="related_to">
      <data key="d7">ACUTE LYMPHOBLASTIC LEUKEMIA</data>
      <data key="d8">ADOLESCENT AND YOUNG ADULT</data>
      <data key="d9">related_to</data>

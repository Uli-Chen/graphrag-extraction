    </edge>
    <edge source="TNM STAGING" target="CANCER STAGING" id="related_to">
      <data key="d7">TNM STAGING</data>
      <data key="d8">CANCER STAGING</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Cancer staging uses TNM staging scores to assign a cancer stage.</data>
      <data key="d12">CANCER STAGING</data>
    </edge>
    <edge source="TNM STAGING" target="METASTASIS" id="related_to">
      <data key="d7">TNM STAGING</data>
      <data key="d8">METASTASIS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Metastasis is one of the three components scored in TNM staging. TNM staging includes the M category to indicate whether cancer has metastasized.</data>
      <data key="d12">TNM STAGING</data>
    </edge>
    <edge source="CANCER STAGING" target="METASTASIS" id="related_to">
      <data key="d7">CANCER STAGING</data>
      <data key="d8">METASTASIS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Cancer staging describes whether cancer has metastasized to distant organs such as the lungs or liver.</data>
      <data key="d12">CANCER STAGING</data>
    </edge>
    <edge source="CANCER STAGING" target="BIOPSY" id="related_to">
      <data key="d7">CANCER STAGING</data>
      <data key="d8">BIOPSY</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">A biopsy removes samples for testing, and the results help determine cancer stage and treatment plan.</data>
      <data key="d12">CANCER STAGING</data>
    </edge>
    <edge source="CANCER STAGING" target="SURGERY" id="related_to">
      <data key="d7">CANCER STAGING</data>
      <data key="d8">SURGERY</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The cancer staging system is used to guide treatment after surgery, making staging an important part of planning post-surgical care.</data>
      <data key="d12">CANCER STAGING</data>
    </edge>
    <edge source="CANCER STAGING" target="CHEMOTHERAPY" id="related_to">
      <data key="d7">CANCER STAGING</data>
      <data key="d8">CHEMOTHERAPY</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The cancer stage determined by the staging system helps guide whether chemotherapy is recommended and which chemotherapy regimen is used.</data>
      <data key="d12">CANCER STAGING</data>
    </edge>
    <edge source="CANCER STAGING" target="IMAGING TESTS" id="related_to">
      <data key="d7">CANCER STAGING</data>
      <data key="d8">IMAGING TESTS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Imaging tests take pictures of the inside of the body and are used during cancer staging and treatment planning.</data>
      <data key="d12">CANCER STAGING</data>
    </edge>
    <edge source="CANCER STAGING" target="BREAST CANCER STAGING" id="related_to">

    <edge source="MAMMOGRAM" target="MAMMOGRAM SCREENING" id="related_to">
      <data key="d7">MAMMOGRAM</data>
      <data key="d8">MAMMOGRAM SCREENING</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Mammogram screening is the use of mammograms to screen for breast cancer</data>
      <data key="d12">MAMMOGRAM</data>
    </edge>
    <edge source="MAMMOGRAM" target="SCREENING MAMMOGRAM" id="related_to">
      <data key="d7">MAMMOGRAM</data>
      <data key="d8">SCREENING MAMMOGRAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">A mammogram is a medical imaging procedure used to examine breast tissue. A screening mammogram is a specific type of mammogram that is performed regularly as a routine preventive measure, even when the individual has no symptoms or signs of breast disease. Screening mammograms are conducted on a scheduled basis, typically for early detection of breast abnormalities, including cancer, in asymptomatic individuals.</data>
      <data key="d12">MAMMOGRAM</data>
    </edge>
    <edge source="MAMMOGRAM" target="DIGITAL MAMMOGRAPHY" id="related_to">
      <data key="d7">MAMMOGRAM</data>
      <data key="d8">DIGITAL MAMMOGRAPHY</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Digital mammography is a standard 2D mammogram technique</data>
      <data key="d12">MAMMOGRAM</data>
    </edge>
    <edge source="MAMMOGRAM" target="BIOPSY" id="related_to">

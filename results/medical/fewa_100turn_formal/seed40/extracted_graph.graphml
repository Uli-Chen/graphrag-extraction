      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Mammograms and MRIs are imaging tests interpreted by a breast diagnostic radiologist</data>
      <data key="d12">MAMMOGRAM</data>
    </edge>
    <edge source="MAMMOGRAM" target="ULTRASOUND" id="related_to">
      <data key="d7">MAMMOGRAM</data>
      <data key="d8">ULTRASOUND</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Mammograms and ultrasound are imaging tests used in breast cancer evaluation</data>

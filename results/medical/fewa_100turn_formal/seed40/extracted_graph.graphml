    <edge source="CANCER SUPPORT COMMUNITY" target="NATIONAL COALITION FOR CANCER SURVIVORSHIP" id="related_to">
      <data key="d7">CANCER SUPPORT COMMUNITY</data>
      <data key="d8">NATIONAL COALITION FOR CANCER SURVIVORSHIP</data>

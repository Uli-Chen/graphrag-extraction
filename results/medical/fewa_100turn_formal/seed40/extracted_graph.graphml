      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Mammogram can be used to guide a biopsy.</data>
      <data key="d12">MAMMOGRAM</data>
    </edge>
    <edge source="MAMMOGRAM" target="MRI" id="related_to">
      <data key="d7">MAMMOGRAM</data>

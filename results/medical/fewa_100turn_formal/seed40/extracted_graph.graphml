    </edge>
    <edge source="SURVEILLANCE" target="FOLLOW-UP TESTING" id="related_to">
      <data key="d7">SURVEILLANCE</data>
      <data key="d8">FOLLOW-UP TESTING</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Follow-up testing after treatment is the surveillance process to find new cancer growth early.</data>
      <data key="d12">SURVEILLANCE</data>
    </edge>
    <edge source="SURVEILLANCE" target="FOLLOW-UP IMAGING" id="related_to">
      <data key="d7">SURVEILLANCE</data>

      <data key="d8">PHASE 4 TRIALS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Phase 4 trials are a phase of clinical trials studying long-term safety and benefit after FDA approval.</data>
      <data key="d12">CLINICAL TRIAL</data>
    </edge>
    <edge source="CLINICAL TRIAL" target="PHASE 1 TRIALS" id="related_to">
      <data key="d7">CLINICAL TRIAL</data>
      <data key="d8">PHASE 1 TRIALS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Phase 1 trials are a phase of clinical trials studying safety and side effects.</data>
      <data key="d12">CLINICAL TRIAL</data>
    </edge>
    <edge source="CLINICAL TRIAL" target="STUDY SPONSOR" id="related_to">
      <data key="d7">CLINICAL TRIAL</data>
      <data key="d8">STUDY SPONSOR</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The study sponsor pays for research-related costs of the clinical trial, including the study drug.</data>
      <data key="d12">CLINICAL TRIAL</data>
    </edge>
    <edge source="CLINICAL TRIAL" target="INDUCTION" id="related_to">
      <data key="d7">CLINICAL TRIAL</data>
      <data key="d8">INDUCTION</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Clinical trial is one of the induction treatment options discussed for primary CNS lymphoma.</data>
      <data key="d12">PRIMARY CNS LYMPHOMA</data>
    </edge>

      <data key="d8">TREATMENT FOR THE SPINE</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">If cancer is found in the spine or spinal fluid, a different induction therapy may be recommended, linking treatment for the spine to the induction phase.</data>
      <data key="d12">TREATMENT FOR THE SPINE</data>
    </edge>
    <edge source="INDUCTION" target="CONSOLIDATION" id="related_to">

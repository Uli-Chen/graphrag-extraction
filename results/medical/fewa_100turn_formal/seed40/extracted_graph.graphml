      <data key="d10">1.0</data>
      <data key="d11">Cancer staging uses TNM scores for tumor, node, and metastasis.</data>
      <data key="d12">CANCER STAGING</data>
    </edge>
    <edge source="CANCER STAGING" target="NASOPHARYNGEAL CANCER STAGING" id="related_to">

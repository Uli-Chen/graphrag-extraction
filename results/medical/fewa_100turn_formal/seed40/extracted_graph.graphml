      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The ovaries release hormones that affect the menstrual cycle in the context of sexual reproduction.</data>
      <data key="d12">MENSTRUAL CYCLE</data>
    </edge>
    <edge source="MENSTRUAL CYCLE" target="PERIOD" id="related_to">

      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Breast cancer staging is the specific application of cancer staging to breast cancer</data>
      <data key="d12">CANCER STAGING</data>
    </edge>
    <edge source="CANCER STAGING" target="TNM SCORES" id="related_to">

      <data key="d10">1.0</data>
      <data key="d11">Breastfeeding is a condition considered in breast cancer screening and testing discussions</data>
      <data key="d12">BREASTFEEDING</data>
    </edge>
    <edge source="MAMMOGRAM" target="EARLY DETECTION" id="related_to">
      <data key="d7">MAMMOGRAM</data>
      <data key="d8">EARLY DETECTION</data>
      <data key="d9">related_to</data>

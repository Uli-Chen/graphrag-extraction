    </edge>
    <edge source="FERTILITY AND FAMILY PLANNING" target="OVARIAN TISSUE BANKING" id="related_to">
      <data key="d7">FERTILITY AND FAMILY PLANNING</data>
      <data key="d8">OVARIAN TISSUE BANKING</data>

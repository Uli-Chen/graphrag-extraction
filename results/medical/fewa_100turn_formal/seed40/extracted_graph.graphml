    <edge source="CERVICAL CANCER" target="STAGE IA1 CANCER" id="related_to">
      <data key="d7">CERVICAL CANCER</data>
      <data key="d8">STAGE IA1 CANCER</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Stage IA1 cancer is a specific stage of cervical cancer</data>

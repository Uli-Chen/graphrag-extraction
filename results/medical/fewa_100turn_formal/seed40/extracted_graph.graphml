      <data key="d8">PHASE 2 TRIALS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Phase 2 trials are a phase of clinical trials studying effectiveness against a specific type of cancer.</data>
      <data key="d12">CLINICAL TRIAL</data>
    </edge>
    <edge source="CLINICAL TRIAL" target="PHASE 4 TRIALS" id="related_to">

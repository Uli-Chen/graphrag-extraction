      <data key="d8">MULTIDISCIPLINARY TEAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The MDT makes treatment decisions and can consider clinical trials as part of a patient's treatment plan.</data>
      <data key="d12">MULTIDISCIPLINARY TEAM</data>
    </edge>

      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The 9-strain HPV vaccine is available in the United States and vaccination is an option for adults aged 45 and under.</data>
      <data key="d12">UNITED STATES</data>
    </edge>
    <edge source="UNITED STATES" target="CERVICAL CANCER" id="related_to">
      <data key="d7">UNITED STATES</data>
      <data key="d8">CERVICAL CANCER</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">In the United States, Pap smears have resulted in much lower rates of cervical cancer.</data>
      <data key="d12">UNITED STATES</data>
    </edge>
    <edge source="UNITED STATES" target="NCCN CANCER CENTERS" id="related_to">
      <data key="d7">UNITED STATES</data>
      <data key="d8">NCCN CANCER CENTERS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">NCCN Cancer Centers are located in the United States.</data>
      <data key="d12">NCCN CANCER CENTERS</data>
    </edge>
    <edge source="UNITED STATES" target="CLINICAL TRIAL" id="related_to">
      <data key="d7">UNITED STATES</data>
      <data key="d8">CLINICAL TRIAL</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">In the United States, clinical trials are widely available to patients, and a range of U.S.-specific resources exist to help individuals locate and access these research opportunities. These resources include NCCN Cancer Centers and the National Cancer Institute, which provide listings and guidance for clinical trials across the country. Together, the United States and its clinical trial infrastructure support patient access to studies through centralized and institutional channels.</data>
      <data key="d12">UNITED STATES</data>
    </edge>
    <edge source="UNITED STATES" target="BASAL CELL SKIN CANCER" id="related_to">

    <edge source="U.S. NATIONAL LIBRARY OF MEDICINE (NLM)" target="U.S." id="related_to">
      <data key="d7">U.S. NATIONAL LIBRARY OF MEDICINE (NLM)</data>
      <data key="d8">U.S.</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>

      <data key="d8">BASAL CELL SKIN CANCER</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The text states that about 3 million cases of basal cell skin cancer are diagnosed every year in the United States</data>
      <data key="d12">BASAL CELL SKIN CANCER</data>
    </edge>
    <edge source="UNITED STATES" target="CLINICAL TRIALS" id="related_to">
      <data key="d7">UNITED STATES</data>
      <data key="d8">CLINICAL TRIALS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">In the United States, clinical trials can be found through NCCN Cancer Centers and the National Cancer Institute</data>
      <data key="d12">UNITED STATES</data>
    </edge>

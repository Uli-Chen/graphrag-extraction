    <edge source="COLD KNIFE CONIZATION (CKC)" target="LOOP ELECTROSURGICAL EXCISION PROCEDURE (LEEP)" id="related_to">
      <data key="d7">COLD KNIFE CONIZATION (CKC)</data>

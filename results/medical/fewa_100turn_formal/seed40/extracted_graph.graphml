    <edge source="DOCTOR" target="SKIN BIOPSY" id="related_to">
      <data key="d7">DOCTOR</data>
      <data key="d8">SKIN BIOPSY</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">A doctor performs a skin biopsy to diagnose squamous cell skin cancer and to inform risk assessment. The doctor selects the biopsy method based on the affected area's size, location, and other factors, and discusses the risk of scarring with the patient.</data>
      <data key="d12">DOCTOR</data>
    </edge>

      <data key="d11">Nasopharyngeal cancer staging is a specific type of cancer staging.</data>
      <data key="d12">NASOPHARYNGEAL CANCER STAGING</data>
    </edge>
    <edge source="CLINICAL STAGING" target="CANCER STAGING" id="related_to">
      <data key="d7">CLINICAL STAGING</data>
      <data key="d8">CANCER STAGING</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Clinical staging is the pre-treatment portion of cancer staging. Cancer staging is often performed as clinical staging before treatment begins.</data>
      <data key="d12">CANCER STAGING</data>
    </edge>
    <edge source="CLINICAL STAGING" target="BREAST EXAM" id="related_to">
      <data key="d7">CLINICAL STAGING</data>
      <data key="d8">BREAST EXAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The breast exam is part of the physical exam that contributes to clinical staging</data>
      <data key="d12">BREAST EXAM</data>
    </edge>
    <edge source="STAGING" target="GRADING" id="related_to">
      <data key="d7">STAGING</data>

    <edge source="GENETIC TEST" target="CARE TEAM" id="related_to">
      <data key="d7">GENETIC TEST</data>
      <data key="d8">CARE TEAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The care team puts together all test results, including genetic tests, to determine the level of prostate cancer risk.</data>

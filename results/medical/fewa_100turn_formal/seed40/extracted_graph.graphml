      <data key="d8">CERVICAL CANCER</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Radiation therapy is used to treat cervical cancer and can have long-term side effects.</data>
      <data key="d12">CERVICAL CANCER</data>
    </edge>
    <edge source="RADIATION THERAPY" target="TREATMENT TEAM" id="related_to">
      <data key="d7">RADIATION THERAPY</data>
      <data key="d8">TREATMENT TEAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Patients should talk to their treatment team about the benefits of radiation therapy compared with the risk of nervous system damage</data>
      <data key="d12">TREATMENT TEAM</data>
    </edge>
    <edge source="RADIATION THERAPY" target="SUPPORTIVE CARE" id="related_to">
      <data key="d7">RADIATION THERAPY</data>

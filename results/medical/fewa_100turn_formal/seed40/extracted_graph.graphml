    </edge>
    <edge source="GENERAL HEALTH TESTS" target="TOBACCO AND ALCOHOL USE HISTORY" id="related_to">
      <data key="d7">GENERAL HEALTH TESTS</data>
      <data key="d8">TOBACCO AND ALCOHOL USE HISTORY</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">General health tests include tobacco and alcohol use history.</data>

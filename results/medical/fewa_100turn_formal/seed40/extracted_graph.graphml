      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Non-metastatic cancer is colon cancer that has not spread and is treated with surgery and sometimes chemotherapy</data>
      <data key="d12">COLON CANCER</data>
    </edge>

      <data key="d12">BLADDER CANCER</data>
    </edge>
    <edge source="CLINICAL TRIALS" target="NCCN CANCER CENTERS" id="related_to">
      <data key="d7">CLINICAL TRIALS</data>
      <data key="d8">NCCN CANCER CENTERS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">NCCN Cancer Centers are listed as a resource for finding clinical trials in the United States.</data>
      <data key="d12">NCCN CANCER CENTERS</data>
    </edge>
    <edge source="CLINICAL TRIALS" target="TREATMENT TEAM" id="related_to">
      <data key="d7">CLINICAL TRIALS</data>
      <data key="d8">TREATMENT TEAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Patients are told to ask their treatment team whether they meet the requirements for a clinical trial.</data>
      <data key="d12">TREATMENT TEAM</data>
    </edge>
    <edge source="CLINICAL TRIALS" target="UNITED STATES" id="related_to">
      <data key="d7">CLINICAL TRIALS</data>
      <data key="d8">UNITED STATES</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The text describes finding clinical trials in the United States through NCCN Cancer Centers and NCI</data>
      <data key="d12">UNITED STATES</data>
    </edge>
    <edge source="CLINICAL TRIALS" target="NCCN" id="related_to">
      <data key="d7">CLINICAL TRIALS</data>
      <data key="d8">NCCN</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">NCCN provides a clinical trial finding resource at NCCN.org/cancercenters.</data>
      <data key="d12">NCCN</data>
    </edge>
    <edge source="CLINICAL TRIALS" target="CARE TEAM" id="related_to">
      <data key="d7">CLINICAL TRIALS</data>
      <data key="d8">CARE TEAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The clinical trials process is closely coordinated with the patient's care team. Patients are advised to ask their care team about access to clinical trials, and the care team plays a central role in facilitating clinical trial participation. In this capacity, the care team also advises the patient on whether a clinical trial might be right for them, helping to guide the decision-making process. Together, these responsibilities ensure that patients receive personalized support and clear information when considering clinical trial options.</data>
      <data key="d12">CLINICAL TRIALS</data>
    </edge>
    <edge source="CLINICAL TRIALS" target="TREATMENT" id="related_to">
      <data key="d7">CLINICAL TRIALS</data>
      <data key="d8">TREATMENT</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Clinical trials are listed as a treatment option for cervical cancer.</data>
      <data key="d12">CLINICAL TRIALS</data>
    </edge>

      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Biopsy tissue samples are studied by histology.</data>
      <data key="d12">HISTOLOGY</data>
    </edge>
    <edge source="BIOPSY" target="MRI SCAN" id="related_to">
      <data key="d7">BIOPSY</data>
      <data key="d8">MRI SCAN</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">MRI may be used before a biopsy to target suspicious areas, during biopsy to guide removal, or after biopsy to see cancer size and location.</data>
      <data key="d12">MRI SCAN</data>
    </edge>

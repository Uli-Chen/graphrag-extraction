      <data key="d12">ANAL CANCER</data>
    </edge>
    <edge source="DIGITAL RECTAL EXAM" target="ANAL CANAL" id="related_to">
      <data key="d7">DIGITAL RECTAL EXAM</data>
      <data key="d8">ANAL CANAL</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Digital rectal exam can detect growths or abnormalities in the anal canal</data>
      <data key="d12">ANAL CANAL</data>
    </edge>
    <edge source="DIGITAL RECTAL EXAM" target="ANUS" id="related_to">

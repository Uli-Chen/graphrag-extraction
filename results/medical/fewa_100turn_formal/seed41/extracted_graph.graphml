      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Lynch syndrome can cause hereditary ovarian cancer.</data>
      <data key="d12">LYNCH SYNDROME</data>
    </edge>
    <edge source="LYNCH SYNDROME" target="GENETIC TESTING" id="related_to">
      <data key="d7">LYNCH SYNDROME</data>
      <data key="d8">GENETIC TESTING</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Genetic testing can identify Lynch syndrome and other hereditary syndromes.</data>
      <data key="d12">LYNCH SYNDROME</data>
    </edge>
    <edge source="LYNCH SYNDROME" target="OVARIAN CANCER" id="related_to">
      <data key="d7">LYNCH SYNDROME</data>
      <data key="d8">OVARIAN CANCER</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Lynch syndrome is a cause of ovarian cancer in addition to colon and uterine cancers.</data>
      <data key="d12">LYNCH SYNDROME</data>
    </edge>
    <edge source="LYNCH SYNDROME" target="GERMLINE TESTING" id="related_to">
      <data key="d7">LYNCH SYNDROME</data>
      <data key="d8">GERMLINE TESTING</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Lynch syndrome is listed as a factor making germline testing more appropriate.</data>
      <data key="d12">GERMLINE TESTING</data>
    </edge>
    <edge source="LYNCH SYNDROME" target="GENETIC COUNSELING" id="related_to">

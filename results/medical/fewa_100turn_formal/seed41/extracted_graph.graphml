      <data key="d8">HERNIA</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Hernia is a possible short- or long-term side effect of colectomy, caused by organs pushing through weakened tissues.</data>
      <data key="d12">HERNIA</data>
    </edge>

      <data key="d11">The doctor discusses blood test results with the patient</data>
      <data key="d12">BLOOD TESTS</data>
    </edge>
    <edge source="DOCTOR" target="GERMLINE TESTING" id="related_to">
      <data key="d7">DOCTOR</data>
      <data key="d8">GERMLINE TESTING</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">A doctor might suggest genetic germline testing if family history suggests inherited cancer risk.</data>
      <data key="d12">GERMLINE TESTING</data>
    </edge>
    <edge source="DOCTOR" target="HEALTH CARE PROVIDER" id="related_to">

      <data key="d11">Chemotherapy regimens are used to treat rectal cancer</data>
      <data key="d12">RECTAL CANCER</data>
    </edge>
    <edge source="RECTAL CANCER" target="CHEMORADIATION" id="related_to">
      <data key="d7">RECTAL CANCER</data>
      <data key="d8">CHEMORADIATION</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Chemoradiation is a possible next treatment for stage 2 and 3 rectal cancers</data>
      <data key="d12">RECTAL CANCER</data>
    </edge>

      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Adenoma is the most common type of adrenal gland tumor.</data>
      <data key="d12">ADRENAL TUMORS</data>
    </edge>
    <edge source="ADENOMA" target="ALDOSTERONOMA" id="related_to">

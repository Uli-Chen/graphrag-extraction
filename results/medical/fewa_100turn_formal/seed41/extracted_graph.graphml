      <data key="d7">CLINICAL TRIAL</data>
      <data key="d8">CLINICAL TRIALS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">CLINICAL TRIAL and CLINICAL TRIALS are related entities; CLINICAL TRIALS is a broader term encompassing clinical trials as research studies.</data>
      <data key="d12">CLINICAL TRIALS</data>
    </edge>
    <edge source="CLINICAL TRIAL" target="PHASE 1 CLINICAL TRIAL" id="related_to">
      <data key="d7">CLINICAL TRIAL</data>
      <data key="d8">PHASE 1 CLINICAL TRIAL</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Phase 1 trials study the dose, safety, and side effects of an investigational drug or treatment approach. They also look for early signs that the drug or approach is helpful.</data>
      <data key="d12">PHASE 1 CLINICAL TRIAL</data>
    </edge>
    <edge source="CLINICAL TRIAL" target="RESEARCH TEAM" id="related_to">
      <data key="d7">CLINICAL TRIAL</data>
      <data key="d8">RESEARCH TEAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Clinical trials are managed by a group of experts called a research team. The research team will review the study with you in detail, including its purpose and the risks and benefits of joining.</data>
      <data key="d12">RESEARCH TEAM</data>
    </edge>
    <edge source="CLINICAL TRIAL" target="TARGETED THERAPIES" id="related_to">
      <data key="d7">CLINICAL TRIAL</data>
      <data key="d8">TARGETED THERAPIES</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Targeted therapies are a type of systemic therapy that can target and attack specific types of cancer cells. They are generally only used for thyroid cancers that can't be treated with surgery or RAI therapy, have returned after treatment, or have spread to areas far from the neck and are continuing to grow.</data>
      <data key="d12">TARGETED THERAPIES</data>
    </edge>
    <edge source="CLINICAL TRIAL" target="IMMUNOTHERAPIES" id="related_to">
      <data key="d7">CLINICAL TRIAL</data>
      <data key="d8">IMMUNOTHERAPIES</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Immunotherapy increases the activity of your immune system, improving your body's ability to find and destroy cancer cells. It is a type of systemic therapy.</data>
      <data key="d12">IMMUNOTHERAPIES</data>
    </edge>
    <edge source="CLINICAL TRIAL" target="NCI'S CANCER INFORMATION SERVICE" id="related_to">
      <data key="d7">CLINICAL TRIAL</data>
      <data key="d8">NCI'S CANCER INFORMATION SERVICE</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">CIS helps patients who need help finding a clinical trial.</data>
      <data key="d12">NCI'S CANCER INFORMATION SERVICE</data>
    </edge>
    <edge source="CLINICAL TRIAL" target="TREATMENT TEAM" id="related_to">
      <data key="d7">CLINICAL TRIAL</data>
      <data key="d8">TREATMENT TEAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">If you find a study that you may be eligible for, ask your treatment team if you meet the requirements.</data>
      <data key="d12">TREATMENT TEAM</data>
    </edge>
    <edge source="CLINICAL TRIAL" target="U.S. NATIONAL LIBRARY OF MEDICINE (NLM)" id="related_to">
      <data key="d7">CLINICAL TRIAL</data>
      <data key="d8">U.S. NATIONAL LIBRARY OF MEDICINE (NLM)</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The U.S. National Library of Medicine maintains ClinicalTrials.gov, a comprehensive worldwide clinical trial registry and search database.</data>
      <data key="d12">U.S. NATIONAL LIBRARY OF MEDICINE (NLM)</data>
    </edge>
    <edge source="CLINICAL TRIAL" target="WORLDWIDE" id="related_to">
      <data key="d7">CLINICAL TRIAL</data>
      <data key="d8">WORLDWIDE</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Worldwide resources provide access to clinical trials for patients around the globe.</data>
      <data key="d12">WORLDWIDE</data>
    </edge>
    <edge source="CLINICAL TRIAL" target="THE ANCHOR STUDY" id="related_to">
      <data key="d7">CLINICAL TRIAL</data>
      <data key="d8">THE ANCHOR STUDY</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The Anchor Study is a clinical study listed as a resource for patients.</data>
      <data key="d12">THE ANCHOR STUDY</data>
    </edge>
    <edge source="CLINICAL TRIAL" target="NCCN GUIDELINES FOR PATIENTS" id="related_to">
      <data key="d7">CLINICAL TRIAL</data>
      <data key="d8">NCCN GUIDELINES FOR PATIENTS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">NCCN patient guidelines provide information about cancer clinical trials and treatment.</data>
      <data key="d12">NCCN GUIDELINES FOR PATIENTS</data>
    </edge>
    <edge source="CLINICAL TRIAL" target="SURVIVORSHIP CARE FOR CANCER-RELATED LATE AND LONG-TERM EFFECTS" id="related_to">
      <data key="d7">CLINICAL TRIAL</data>
      <data key="d8">SURVIVORSHIP CARE FOR CANCER-RELATED LATE AND LONG-TERM EFFECTS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">This resource addresses late and long-term effects of cancer treatment for survivors.</data>
      <data key="d12">SURVIVORSHIP CARE FOR CANCER-RELATED LATE AND LONG-TERM EFFECTS</data>
    </edge>
    <edge source="CLINICAL TRIAL" target="SURVIVORSHIP CARE FOR HEALTHY LIVING" id="related_to">
      <data key="d7">CLINICAL TRIAL</data>
      <data key="d8">SURVIVORSHIP CARE FOR HEALTHY LIVING</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">This resource addresses healthy living after cancer treatment for survivors.</data>
      <data key="d12">SURVIVORSHIP CARE FOR HEALTHY LIVING</data>
    </edge>
    <edge source="CLINICAL TRIALS" target="NCCN CANCER CENTERS" id="related_to">
      <data key="d7">CLINICAL TRIALS</data>
      <data key="d8">NCCN CANCER CENTERS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">NCCN Cancer Centers are listed as a resource for finding clinical trials in the United States.</data>
      <data key="d12">CLINICAL TRIALS</data>
    </edge>
    <edge source="CLINICAL TRIALS" target="CARE TEAM" id="related_to">
      <data key="d7">CLINICAL TRIALS</data>
      <data key="d8">CARE TEAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The clinical trials process is closely coordinated with the patients care team. Patients are advised to ask their care team about access to clinical trials, and the care team plays a central role in facilitating clinical trial participation. In this capacity, the care team also advises the patient on whether a clinical trial might be right for them, helping to guide the decision-making process. Together, these responsibilities ensure that patients receive personalized support and clear information when considering clinical trial options.</data>
      <data key="d12">CLINICAL TRIALS</data>
    </edge>
    <edge source="CLINICAL TRIALS" target="RESEARCH TEAM" id="related_to">
      <data key="d7">CLINICAL TRIALS</data>
      <data key="d8">RESEARCH TEAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Clinical trials are research studies conducted to evaluate medical, surgical, or behavioral interventions. These trials are managed by a dedicated research team, which plays a central role in the study process. The research team is responsible for reviewing the study details with participants, ensuring they understand the purpose, procedures, risks, and potential benefits before enrollment. In addition to guiding participants through the informed consent process, the research team actively helps collect research data throughout the trial. They also coordinate patient care, working alongside healthcare providers to ensure that participants receive appropriate medical attention and that the trial protocol is followed. Thus, the research team bridges the gap between clinical care and research, supporting both data integrity and participant well-being. Together, clinical trials and the research team form an integrated framework for advancing medical knowledge while maintaining patient safety and care coordination.</data>
      <data key="d12">RESEARCH TEAM</data>
    </edge>
    <edge source="CLINICAL TRIALS" target="STUDY SPONSOR" id="related_to">
      <data key="d7">CLINICAL TRIALS</data>
      <data key="d8">STUDY SPONSOR</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The study sponsor pays for research-related costs, including the study drug, so there is no fee to enroll.</data>
      <data key="d12">STUDY SPONSOR</data>
    </edge>
    <edge source="CLINICAL TRIALS" target="NCCN" id="related_to">
      <data key="d7">CLINICAL TRIALS</data>
      <data key="d8">NCCN</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">NCCN provides a clinical trial finding resource at NCCN.org/cancercenters.</data>
      <data key="d12">CLINICAL TRIALS</data>
    </edge>
    <edge source="CLINICAL TRIALS" target="TREATMENT" id="related_to">
      <data key="d7">CLINICAL TRIALS</data>
      <data key="d8">TREATMENT</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Clinical trials are listed as a treatment option for cervical cancer</data>
      <data key="d12">CLINICAL TRIALS</data>
    </edge>
    <edge source="CLINICAL TRIALS" target="UNITED STATES" id="related_to">
      <data key="d7">CLINICAL TRIALS</data>
      <data key="d8">UNITED STATES</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The text describes finding clinical trials in the United States through NCCN Cancer Centers and NCI</data>
      <data key="d12">CLINICAL TRIALS</data>
    </edge>
    <edge source="CLINICAL TRIALS" target="OVARIAN CANCER" id="related_to">
      <data key="d7">CLINICAL TRIALS</data>
      <data key="d8">OVARIAN CANCER</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Clinical trials are presented as a possible treatment option for ovarian cancer.</data>
      <data key="d12">OVARIAN CANCER</data>
    </edge>
    <edge source="CLINICAL TRIALS" target="TREATMENT TEAM" id="related_to">
      <data key="d7">CLINICAL TRIALS</data>
      <data key="d8">TREATMENT TEAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Patients are told to ask their treatment team whether they meet the requirements for a clinical trial.</data>
      <data key="d12">TREATMENT TEAM</data>
    </edge>
    <edge source="CLINICAL TRIALS" target="CANCER TREATMENT" id="related_to">
      <data key="d7">CLINICAL TRIALS</data>
      <data key="d8">CANCER TREATMENT</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Clinical trials study the safety and effectiveness of investigational cancer treatments. Clinical trials may be included as options within a cancer treatment plan.</data>
      <data key="d12">CLINICAL TRIALS</data>
    </edge>
    <edge source="CLINICAL TRIALS" target="U.S. NATIONAL LIBRARY OF MEDICINE" id="related_to">
      <data key="d7">CLINICAL TRIALS</data>
      <data key="d8">U.S. NATIONAL LIBRARY OF MEDICINE</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">NLM operates clinicaltrials.gov, a database for finding clinical trials.</data>
      <data key="d12">CLINICAL TRIALS</data>
    </edge>
    <edge source="UNITED STATES" target="NCCN CANCER CENTERS" id="related_to">
      <data key="d7">UNITED STATES</data>
      <data key="d8">NCCN CANCER CENTERS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">NCCN Cancer Centers are located in the United States.</data>
      <data key="d12">UNITED STATES</data>
    </edge>
    <edge source="UNITED STATES" target="HPV VACCINATION" id="related_to">
      <data key="d7">UNITED STATES</data>
      <data key="d8">HPV VACCINATION</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The 9-strain HPV vaccine is available in the United States and vaccination is an option for adults aged 45 and under.</data>
      <data key="d12">HPV VACCINATION</data>
    </edge>
    <edge source="UNITED STATES" target="CLINICAL TRIAL" id="related_to">
      <data key="d7">UNITED STATES</data>
      <data key="d8">CLINICAL TRIAL</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">In the United States, clinical trials are widely available to patients, and a range of U.S.-specific resources exist to help individuals locate and access these research opportunities. These resources include NCCN Cancer Centers and the National Cancer Institute, which provide listings and guidance for clinical trials across the country. Together, the United States and its clinical trial infrastructure support patient access to studies through centralized and institutional channels.</data>
      <data key="d12">CLINICAL TRIAL</data>
    </edge>
    <edge source="UNITED STATES" target="PAP SMEARS" id="related_to">
      <data key="d7">UNITED STATES</data>
      <data key="d8">PAP SMEARS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Pap smears are used in the United States, where they have helped lower cervical cancer rates.</data>
      <data key="d12">PAP SMEARS</data>
    </edge>
    <edge source="UNITED STATES" target="BASAL CELL SKIN CANCER" id="related_to">
      <data key="d7">UNITED STATES</data>
      <data key="d8">BASAL CELL SKIN CANCER</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The text states that about 3 million cases of basal cell skin cancer are diagnosed every year in the United States</data>
      <data key="d12">BASAL CELL SKIN CANCER</data>
    </edge>
    <edge source="NATIONAL CANCER INSTITUTE (NCI)" target="U.S." id="related_to">
      <data key="d7">NATIONAL CANCER INSTITUTE (NCI)</data>
      <data key="d8">U.S.</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The National Cancer Institute is a U.S. national institute, as indicated by its cancer.gov government website.</data>
      <data key="d12">NATIONAL CANCER INSTITUTE (NCI)</data>
    </edge>
    <edge source="NATIONAL CANCER INSTITUTE" target="CLINICAL TRIAL" id="related_to">
      <data key="d7">NATIONAL CANCER INSTITUTE</data>
      <data key="d8">CLINICAL TRIAL</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The National Cancer Institute (NCI) provides comprehensive clinical trial information and search resources. These resources are available through the NCI's official website at cancer.gov/about-cancer/treatment/clinical-trials/search, where patients, caregivers, and researchers can locate ongoing clinical trials. In addition to the online search tool, the National Cancer Institute's Cancer Information Service is also available to help individuals find clinical trials that may be relevant to their needs. Together, these offerings ensure that the public has access to both self-service search tools and personalized assistance when seeking information about clinical trials.</data>
      <data key="d12">CLINICAL TRIAL</data>
    </edge>
    <edge source="NATIONAL CANCER INSTITUTE" target="NCI'S CANCER INFORMATION SERVICE" id="related_to">
      <data key="d7">NATIONAL CANCER INSTITUTE</data>
      <data key="d8">NCI'S CANCER INFORMATION SERVICE</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The Cancer Information Service is part of the National Cancer Institute and helps people find clinical trials.</data>
      <data key="d12">NCI'S CANCER INFORMATION SERVICE</data>
    </edge>
    <edge source="NATIONAL CANCER INSTITUTE" target="U.S. NATIONAL LIBRARY OF MEDICINE" id="related_to">
      <data key="d7">NATIONAL CANCER INSTITUTE</data>
      <data key="d8">U.S. NATIONAL LIBRARY OF MEDICINE</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The National Cancer Institute (NCI) and the U.S. National Library of Medicine (NLM) are both U.S. government health organizations and official resources for finding clinical trials. NCI provides cancer-specific clinical trial search tools, including access through cancer.gov, while NLM maintains ClinicalTrials.gov, a comprehensive database of clinical studies. Together, these two entities serve as key sources for patients, researchers, and the public seeking information on clinical trials, with NCI focusing on cancer-related trials and NLM offering a broader clinical trial registry. Both are listed as reliable, government-supported resources for clinical-trial searching.</data>
      <data key="d12">NATIONAL CANCER INSTITUTE</data>
    </edge>
    <edge source="U.S. NATIONAL LIBRARY OF MEDICINE" target="CLINICAL TRIAL" id="related_to">
      <data key="d7">U.S. NATIONAL LIBRARY OF MEDICINE</data>
      <data key="d8">CLINICAL TRIAL</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The U.S. National Library of Medicine maintains ClinicalTrials.gov, a comprehensive worldwide clinical trial registry and search database. This resource is provided by the U.S. National Library of Medicine to help users find clinical trials. ClinicalTrials.gov serves as a global repository, allowing researchers, patients, and the public to locate and access information about clinical trials conducted around the world.</data>
      <data key="d12">U.S. NATIONAL LIBRARY OF MEDICINE</data>
    </edge>
    <edge source="U.S. NATIONAL LIBRARY OF MEDICINE" target="WORLDWIDE" id="related_to">
      <data key="d7">U.S. NATIONAL LIBRARY OF MEDICINE</data>
      <data key="d8">WORLDWIDE</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The U.S. National Library of Medicine's clinicaltrials.gov database is a worldwide resource for finding clinical trials.</data>
      <data key="d12">U.S. NATIONAL LIBRARY OF MEDICINE</data>
    </edge>
    <edge source="U.S. NATIONAL LIBRARY OF MEDICINE" target="UNITED STATES" id="related_to">
      <data key="d7">U.S. NATIONAL LIBRARY OF MEDICINE</data>
      <data key="d8">UNITED STATES</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The U.S. National Library of Medicine (NLM) is a U.S. federal institution and government organization operating within the United States. As a U.S. government library, it is explicitly identified as an American institution and serves as the national library of medicine for the country. In addition to its role as a federal library, the NLM is known for providing the ClinicalTrials.gov database, a key resource for clinical research information. The NLM operates under the broader framework of the United States, functioning as a U.S. government entity dedicated to medical and health information.</data>
      <data key="d12">U.S. NATIONAL LIBRARY OF MEDICINE</data>
    </edge>
    <edge source="U.S. NATIONAL LIBRARY OF MEDICINE" target="U.S. FOOD AND DRUG ADMINISTRATION" id="related_to">
      <data key="d7">U.S. NATIONAL LIBRARY OF MEDICINE</data>
      <data key="d8">U.S. FOOD AND DRUG ADMINISTRATION</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The FDA and NLM are U.S. government health-related agencies; NLM provides clinical trial data and FDA reviews treatments.</data>
      <data key="d12">U.S. NATIONAL LIBRARY OF MEDICINE</data>
    </edge>
    <edge source="U.S. NATIONAL LIBRARY OF MEDICINE" target="CANCER INFORMATION SERVICE" id="related_to">
      <data key="d7">U.S. NATIONAL LIBRARY OF MEDICINE</data>
      <data key="d8">CANCER INFORMATION SERVICE</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The U.S. NATIONAL LIBRARY OF MEDICINE (NLM) and the CANCER INFORMATION SERVICE (CIS) are both organizations that help people find clinical trials. NLM maintains ClinicalTrials.gov, a comprehensive online database of clinical studies, while CIS offers direct, personal assistance to individuals seeking information about clinical trial options. Together, they provide complementary support: NLM supplies the searchable public resource, and CIS delivers one-on-one guidance to help users navigate the process.</data>
      <data key="d12">U.S. NATIONAL LIBRARY OF MEDICINE</data>
    </edge>
    <edge source="U.S. NATIONAL LIBRARY OF MEDICINE" target="CLINICAL TRIALS" id="related_to">
      <data key="d7">U.S. NATIONAL LIBRARY OF MEDICINE</data>
      <data key="d8">CLINICAL TRIALS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">NLM operates clinicaltrials.gov, a database for clinical trials. NLM operates clinicaltrials.gov, a database for searching clinical trials.</data>
      <data key="d12">U.S. NATIONAL LIBRARY OF MEDICINE</data>
    </edge>
    <edge source="U.S. NATIONAL LIBRARY OF MEDICINE" target="NCCN CANCER CENTERS" id="related_to">
      <data key="d7">U.S. NATIONAL LIBRARY OF MEDICINE</data>
      <data key="d8">NCCN CANCER CENTERS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">NCCN Cancer Centers and the U.S. National Library of Medicine (NLM) are both recognized resources for locating clinical trials. NCCN Cancer Centers are specifically listed as a resource for finding clinical trials within the United States, while the NLM provides the worldwide clinicaltrials.gov database. Together, these two entities offer complementary access to clinical trial information: NCCN Cancer Centers focus on U.S.-based cancer centers, and the NLM supplies a comprehensive, global database of clinical trials.</data>
      <data key="d12">U.S. NATIONAL LIBRARY OF MEDICINE</data>
    </edge>
    <edge source="U.S. NATIONAL LIBRARY OF MEDICINE" target="NCCN" id="related_to">
      <data key="d7">U.S. NATIONAL LIBRARY OF MEDICINE</data>
      <data key="d8">NCCN</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The National Comprehensive Cancer Network (NCCN) and the U.S. National Library of Medicine (NLM) are both recognized resources for locating clinical trials. NCCN provides clinical trial resources specifically for the United States, primarily through its network of NCCN Cancer Centers. In contrast, the U.S. National Library of Medicine offers worldwide clinical trial resources, most notably through the ClinicalTrials.gov database. Together, they serve as complementary tools: NCCN focuses on U.S.-based trial options, while NLM covers global trial listings.</data>
      <data key="d12">U.S. NATIONAL LIBRARY OF MEDICINE</data>
    </edge>
    <edge source="U.S. NATIONAL LIBRARY OF MEDICINE" target="NATIONAL CANCER INSTITUTE" id="related_to">
      <data key="d7">U.S. NATIONAL LIBRARY OF MEDICINE</data>
      <data key="d8">NATIONAL CANCER INSTITUTE</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The National Cancer Institute (NCI) and the U.S. National Library of Medicine (NLM) are both U.S. government health organizations and official resources for finding clinical trials. NCI provides cancer-specific clinical trial search tools, including access through cancer.gov, while NLM maintains ClinicalTrials.gov, a comprehensive database of clinical studies. Together, these two entities serve as key sources for patients, researchers, and the public seeking information on clinical trials, with NCI focusing on cancer-related trials and NLM offering a broader clinical trial registry. Both are listed as reliable, government-supported resources for clinical-trial searching.</data>
      <data key="d12">U.S. NATIONAL LIBRARY OF MEDICINE</data>
    </edge>
    <edge source="U.S. NATIONAL LIBRARY OF MEDICINE (NLM)" target="U.S." id="related_to">
      <data key="d7">U.S. NATIONAL LIBRARY OF MEDICINE (NLM)</data>
      <data key="d8">U.S.</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The U.S. National Library of Medicine is explicitly a U.S. institution.</data>
      <data key="d12">U.S. NATIONAL LIBRARY OF MEDICINE (NLM)</data>
    </edge>
    <edge source="TARGETED THERAPY" target="INFECTIONS" id="related_to">
      <data key="d7">TARGETED THERAPY</data>
      <data key="d8">INFECTIONS</data>

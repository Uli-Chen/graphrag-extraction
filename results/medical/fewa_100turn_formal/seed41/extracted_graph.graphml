      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Lynch syndrome is a factor that should lead a person to ask about genetic counseling</data>
      <data key="d12">GENETIC COUNSELING</data>
    </edge>
    <edge source="LYNCH SYNDROME" target="MISMATCH REPAIR TESTING" id="related_to">

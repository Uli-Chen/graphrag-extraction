      <data key="d8">MSI-H</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">MSI-H stands for microsatellite instability-high</data>
      <data key="d12">MICROSATELLITE INSTABILITY</data>
    </edge>
    <edge source="DEFICIENT MISMATCH REPAIR" target="MSI-H" id="related_to">
      <data key="d7">DEFICIENT MISMATCH REPAIR</data>
      <data key="d8">MSI-H</data>

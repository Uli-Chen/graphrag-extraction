      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">EBRT is given together with platinum chemotherapy as part of chemoradiation for cervical cancer.</data>
      <data key="d12">EBRT</data>
    </edge>
    <edge source="EBRT" target="VAGINAL BRACHYTHERAPY" id="related_to">

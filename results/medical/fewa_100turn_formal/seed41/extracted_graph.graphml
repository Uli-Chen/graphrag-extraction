      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">BeTobaccoFree.gov is an online resource to help quit tobacco use, which improves cancer treatment outcomes.</data>
      <data key="d12">BETOBACCOFREE.GOV</data>
    </edge>
    <edge source="CDC.GOV/TOBACCO" target="CDC" id="related_to">
      <data key="d7">CDC.GOV/TOBACCO</data>
      <data key="d8">CDC</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">CDC.gov/tobacco is the official tobacco resource page of the CDC (Centers for Disease Control and Prevention). As a dedicated web resource maintained by the CDC, it is designed to provide reliable information and online support for individuals looking to quit smoking or vaping. The CDC is the organization responsible for and associated with this website, ensuring that the content and resources offered align with public health guidelines and evidence-based cessation strategies.</data>
      <data key="d12">CDC.GOV/TOBACCO</data>
    </edge>

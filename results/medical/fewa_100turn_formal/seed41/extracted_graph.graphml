      <data key="d8">STAGE 1 RECTAL CANCER</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Rectal cancer can be assigned stage 1 when the tumor has grown into the second or third muscle layer of the rectal wall</data>
      <data key="d12">RECTAL CANCER</data>
    </edge>
    <edge source="RECTAL CANCER" target="STAGE 2 RECTAL CANCER" id="related_to">
      <data key="d7">RECTAL CANCER</data>

    <edge source="OVARIAN CANCER" target="ABDOMINAL AND PELVIC EXAM" id="related_to">
      <data key="d7">OVARIAN CANCER</data>
      <data key="d8">ABDOMINAL AND PELVIC EXAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">This exam is used when ovarian cancer is suspected to detect abnormalities in the abdomen, ovaries, cervix, and uterus.</data>
      <data key="d12">OVARIAN CANCER</data>
    </edge>
    <edge source="OVARIAN CANCER" target="ABDOMINAL EXAM" id="related_to">
      <data key="d7">OVARIAN CANCER</data>
      <data key="d8">ABDOMINAL EXAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The abdominal exam can reveal organ size changes, tenderness, or ascites that may be related to ovarian cancer.</data>
      <data key="d12">OVARIAN CANCER</data>
    </edge>
    <edge source="OVARIAN CANCER" target="PELVIC EXAM" id="related_to">
      <data key="d7">OVARIAN CANCER</data>
      <data key="d8">PELVIC EXAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The pelvic exam checks for abnormal changes in the ovaries and nearby reproductive organs that could indicate ovarian cancer.</data>
      <data key="d12">OVARIAN CANCER</data>
    </edge>
    <edge source="OVARIAN CANCER" target="CARE TEAM" id="related_to">
      <data key="d7">OVARIAN CANCER</data>
      <data key="d8">CARE TEAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The care team is involved in evaluating and treating ovarian cancer</data>
      <data key="d12">OVARIAN CANCER</data>
    </edge>
    <edge source="OVARIAN CANCER" target="BIOPSY" id="related_to">
      <data key="d7">OVARIAN CANCER</data>
      <data key="d8">BIOPSY</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Biopsy is listed as a diagnostic test for suspected ovarian cancer.</data>
      <data key="d12">OVARIAN CANCER</data>
    </edge>
    <edge source="OVARIAN CANCER" target="IMAGING TESTS" id="related_to">
      <data key="d7">OVARIAN CANCER</data>
      <data key="d8">IMAGING TESTS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Imaging tests reveal the location, size, and shape of an ovarian tumor and whether cancer has spread beyond the ovaries.</data>
      <data key="d12">IMAGING TESTS</data>
    </edge>
    <edge source="OVARIAN CANCER" target="BLOOD TESTS" id="related_to">
      <data key="d7">OVARIAN CANCER</data>
      <data key="d8">BLOOD TESTS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Blood tests are listed as part of the evaluation for suspected ovarian cancer.</data>
      <data key="d12">OVARIAN CANCER</data>
    </edge>
    <edge source="OVARIAN CANCER" target="BIOMARKER TESTING" id="related_to">
      <data key="d7">OVARIAN CANCER</data>
      <data key="d8">BIOMARKER TESTING</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Biomarker testing is listed as part of the evaluation for suspected ovarian cancer.</data>
      <data key="d12">OVARIAN CANCER</data>
    </edge>
    <edge source="OVARIAN CANCER" target="SURGERY" id="related_to">
      <data key="d7">OVARIAN CANCER</data>
      <data key="d8">SURGERY</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Testing helps determine whether surgery first is the best treatment for ovarian cancer; surgery may not be possible depending on tumor size and location or other health factors.</data>
      <data key="d12">OVARIAN CANCER</data>
    </edge>
    <edge source="OVARIAN CANCER" target="CANCER" id="related_to">
      <data key="d7">OVARIAN CANCER</data>
      <data key="d8">CANCER</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Ovarian cancer is a specific type of cancer</data>
      <data key="d12">OVARIAN CANCER</data>
    </edge>
    <edge source="OVARIAN CANCER" target="TRANSABDOMINAL ULTRASOUND" id="related_to">
      <data key="d7">OVARIAN CANCER</data>
      <data key="d8">TRANSABDOMINAL ULTRASOUND</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Transabdominal ultrasound can show the ovaries and nearby tissues during evaluation for ovarian cancer.</data>
      <data key="d12">TRANSABDOMINAL ULTRASOUND</data>
    </edge>
    <edge source="OVARIAN CANCER" target="RECTOVAGINAL EXAM" id="related_to">
      <data key="d7">OVARIAN CANCER</data>
      <data key="d8">RECTOVAGINAL EXAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The rectovaginal exam is performed to check for cancer in the space between the rectum and vagina.</data>
      <data key="d12">OVARIAN CANCER</data>
    </edge>
    <edge source="OVARIAN CANCER" target="UTERINE CANCER" id="related_to">
      <data key="d7">OVARIAN CANCER</data>
      <data key="d8">UTERINE CANCER</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Uterine cancer is considered during the evaluation of suspected ovarian cancer, and an endometrial biopsy can rule it out.</data>
      <data key="d12">OVARIAN CANCER</data>
    </edge>
    <edge source="OVARIAN CANCER" target="CERVICAL CANCER" id="related_to">
      <data key="d7">OVARIAN CANCER</data>
      <data key="d8">CERVICAL CANCER</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The text distinguishes ovarian cancer from cervical cancer, noting that a Pap test detects cervical cancer but not ovarian cancer.</data>
      <data key="d12">OVARIAN CANCER</data>
    </edge>
    <edge source="OVARIAN CANCER" target="ENDOMETRIAL BIOPSY" id="related_to">
      <data key="d7">OVARIAN CANCER</data>
      <data key="d8">ENDOMETRIAL BIOPSY</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Endometrial biopsy may be part of the initial pelvic exam when ovarian cancer is suspected, and can rule out uterine cancer instead.</data>
      <data key="d12">OVARIAN CANCER</data>
    </edge>
    <edge source="OVARIAN CANCER" target="ULTRASOUND" id="related_to">
      <data key="d7">OVARIAN CANCER</data>
      <data key="d8">ULTRASOUND</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Ultrasound is often the first imaging test used to look for ovarian cancer.</data>
      <data key="d12">OVARIAN CANCER</data>
    </edge>
    <edge source="OVARIAN CANCER" target="TRANSVAGINAL ULTRASOUND" id="related_to">
      <data key="d7">OVARIAN CANCER</data>
      <data key="d8">TRANSVAGINAL ULTRASOUND</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Transvaginal ultrasound helps the doctor see the ovaries more clearly when looking for ovarian cancer.</data>
      <data key="d12">OVARIAN CANCER</data>
    </edge>
    <edge source="OVARIAN CANCER" target="PAP TEST" id="related_to">
      <data key="d7">OVARIAN CANCER</data>
      <data key="d8">PAP TEST</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The Pap test is specifically noted as not being used to detect ovarian cancer, although it appears in the discussion of suspected ovarian cancer.</data>
      <data key="d12">OVARIAN CANCER</data>
    </edge>

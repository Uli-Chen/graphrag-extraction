      <data key="d8">T-ALL</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">T-ALL is a subtype of ALL that starts in T-cell lymphocytes.</data>
      <data key="d12">ALL</data>
    </edge>

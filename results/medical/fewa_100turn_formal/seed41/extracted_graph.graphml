    </edge>
    <edge source="TUMOR MUTATION TESTING" target="BIOPSY" id="related_to">
      <data key="d7">TUMOR MUTATION TESTING</data>
      <data key="d8">BIOPSY</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">A tumor or blood sample from a biopsy is used for tumor mutation testing.</data>
      <data key="d12">TUMOR MUTATION TESTING</data>
    </edge>
    <edge source="TUMOR TESTING" target="MUTATION" id="related_to">
      <data key="d7">TUMOR TESTING</data>
      <data key="d8">MUTATION</data>
      <data key="d9">related_to</data>

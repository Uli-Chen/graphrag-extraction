    <edge source="MRI" target="CARE TEAM" id="related_to">
      <data key="d7">MRI</data>
      <data key="d8">CARE TEAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The care team relies on MRI scans as a key diagnostic and monitoring tool throughout the patients journey, including during diagnosis, treatment, and follow-up care. Because the MRI procedure involves being inside an enclosed scanner, the care team should be informed if the patient feels nervous or anxious in enclosed spaces before the scan takes place. This allows the team to make appropriate accommodations and ensure the patients comfort and safety.</data>
      <data key="d12">CARE TEAM</data>
    </edge>

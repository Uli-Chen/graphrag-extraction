    <edge source="SURGERY" target="LAPAROSCOPIC SURGERY" id="related_to">
      <data key="d7">SURGERY</data>
      <data key="d8">LAPAROSCOPIC SURGERY</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>

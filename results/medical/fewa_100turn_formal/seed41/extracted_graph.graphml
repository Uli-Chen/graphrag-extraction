    </edge>
    <edge source="TUMOR MUTATION TESTING" target="BIOMARKER TESTING" id="related_to">
      <data key="d7">TUMOR MUTATION TESTING</data>
      <data key="d8">BIOMARKER TESTING</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Tumor mutation testing is closely related to biomarker testing and molecular profiling</data>

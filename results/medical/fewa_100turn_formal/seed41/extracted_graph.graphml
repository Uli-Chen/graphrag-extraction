      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The cancer care team may give the patient a referral to a fertility specialist to discuss fertility preservation.</data>
      <data key="d12">FERTILITY SPECIALIST</data>
    </edge>
    <edge source="SYSTEMIC THERAPY" target="CARE TEAM" id="related_to">

    <edge source="LUMBAR PUNCTURE" target="DIAGNOSTIC TESTS" id="related_to">
      <data key="d7">LUMBAR PUNCTURE</data>
      <data key="d8">DIAGNOSTIC TESTS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">A lumbar puncture is a diagnostic test that checks spinal fluid for leukemia cells</data>

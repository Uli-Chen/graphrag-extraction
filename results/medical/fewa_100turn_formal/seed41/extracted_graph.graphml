      <data key="d8">SURVEILLANCE</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Surveillance is conducted to monitor for recurrence or relapse.</data>
      <data key="d12">RECURRENCE</data>
    </edge>
    <edge source="RECURRENCE" target="CERVICAL CANCER" id="related_to">
      <data key="d7">RECURRENCE</data>
      <data key="d8">CERVICAL CANCER</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Cervical cancer can recur after treatment, and recurrence is a major focus of follow-up care.</data>
      <data key="d12">RECURRENCE</data>
    </edge>
    <edge source="RECURRENCE" target="IMAGING" id="related_to">
      <data key="d7">RECURRENCE</data>
      <data key="d8">IMAGING</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">If recurrence is suspected, imaging tests such as CT, PET, or MRI are used to check for cancer spread.</data>
      <data key="d12">RECURRENCE</data>
    </edge>
    <edge source="RECURRENCE" target="CLINICAL TRIAL" id="related_to">
      <data key="d7">RECURRENCE</data>
      <data key="d8">CLINICAL TRIAL</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Patients with persistent or recurrent ovarian cancer are encouraged to consider a clinical trial.</data>
      <data key="d12">RECURRENCE</data>
    </edge>
    <edge source="RECURRENCE" target="BRACHYTHERAPY" id="related_to">
      <data key="d7">RECURRENCE</data>
      <data key="d8">BRACHYTHERAPY</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Brachytherapy may be given for recurrent cervical cancer, particularly with radical hysterectomy or pelvic radiation.</data>
      <data key="d12">RECURRENCE</data>
    </edge>
    <edge source="RECURRENCE" target="ABDOMINOPERINEAL RESECTION (APR)" id="related_to">
      <data key="d7">RECURRENCE</data>
      <data key="d8">ABDOMINOPERINEAL RESECTION (APR)</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">If cancer returns to the anal area, abdominoperineal resection is recommended</data>
      <data key="d12">RECURRENCE</data>
    </edge>
    <edge source="RECURRENCE" target="PELVIC EXENTERATION" id="related_to">
      <data key="d7">RECURRENCE</data>
      <data key="d8">PELVIC EXENTERATION</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Pelvic exenteration is a surgical treatment option for cervical cancer that returns only to the pelvis.</data>

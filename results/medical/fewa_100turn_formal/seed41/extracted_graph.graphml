      <data key="d8">PHYSICAL EXAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">GENERAL HEALTH TESTS encompass a range of routine medical evaluations, and PHYSICAL EXAM is one of the key components included within them. In other words, a physical exam is one of the general health tests performed to assess overall health.</data>
      <data key="d12">GENERAL HEALTH TESTS</data>
    </edge>

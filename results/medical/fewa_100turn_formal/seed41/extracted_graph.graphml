      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">If cancer metastasizes after initial radiation therapy, radiation therapy cannot be used again on the same areas.</data>
      <data key="d12">METASTASIS</data>
    </edge>
    <edge source="METASTASIS" target="PROSTATE CANCER" id="related_to">

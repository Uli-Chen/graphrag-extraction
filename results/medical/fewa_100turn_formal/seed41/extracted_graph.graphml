      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Surgical staging determines how far the rectal cancer has grown and whether lymph nodes contain cancer</data>
      <data key="d12">RECTAL CANCER</data>
    </edge>

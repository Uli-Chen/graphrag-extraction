    <edge source="SMOKEFREE.GOV" target="CDC" id="related_to">
      <data key="d7">SMOKEFREE.GOV</data>
      <data key="d8">CDC</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">SmokeFree.gov and the Centers for Disease Control and Prevention (CDC) are both recognized as online support resources for individuals seeking to quit tobacco use. Specifically, SmokeFree.gov is listed as an online support option to help people quit smoking or vaping, while the CDC's website, CDC.gov/tobacco, is also listed as an online support resource for quitting tobacco. Together, they serve as accessible digital tools for tobacco cessation, offering guidance and assistance to those looking to stop using tobacco products.</data>
      <data key="d12">SMOKEFREE.GOV</data>
    </edge>
    <edge source="SMOKEFREE.GOV" target="CDC.GOV/TOBACCO" id="related_to">
      <data key="d7">SMOKEFREE.GOV</data>
      <data key="d8">CDC.GOV/TOBACCO</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">SmokeFree.gov and CDC.gov/tobacco are both recognized as recommended online resources for quitting smoking and vaping. They are frequently listed together as credible, web-based smoking cessation support options, providing individuals with accessible tools and information to help them stop using tobacco products or e-cigarettes. Both websites serve as authoritative sources of guidance for those seeking to quit.</data>
      <data key="d12">SMOKEFREE.GOV</data>
    </edge>
    <edge source="SMOKEFREE.GOV" target="QUITTING SMOKING" id="related_to">
      <data key="d7">SMOKEFREE.GOV</data>
      <data key="d8">QUITTING SMOKING</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">SmokeFree.gov is listed as an online support resource to help people quit smoking</data>
      <data key="d12">SMOKEFREE.GOV</data>
    </edge>
    <edge source="SMOKEFREE.GOV" target="BETOBACCOFREE.GOV" id="related_to">
      <data key="d7">SMOKEFREE.GOV</data>
      <data key="d8">BETOBACCOFREE.GOV</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">SmokeFree.gov and BeTobaccoFree.gov are two online support websites that are listed together as recommended resources for individuals seeking help to quit smoking, tobacco use, and vaping. Both are highlighted as trusted digital cessation support options, offering guidance and tools for those ready to stop using tobacco products or e-cigarettes.</data>
      <data key="d12">SMOKEFREE.GOV</data>
    </edge>
    <edge source="SMOKEFREE.GOV" target="BETOBACCOFREE" id="related_to">
      <data key="d7">SMOKEFREE.GOV</data>
      <data key="d8">BETOBACCOFREE</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Both are listed together in the text as online support websites for quitting smoking or vaping</data>
      <data key="d12">SMOKEFREE.GOV</data>
    </edge>
    <edge source="SMOKEFREE.GOV" target="SMOKING" id="related_to">
      <data key="d7">SMOKEFREE.GOV</data>
      <data key="d8">SMOKING</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">SmokeFree.gov is designed for people who smoke and want support quitting</data>
      <data key="d12">SMOKEFREE.GOV</data>

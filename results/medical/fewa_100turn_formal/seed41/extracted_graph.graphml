      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Surveillance includes regular physical and pelvic exams.</data>
      <data key="d12">PHYSICAL AND PELVIC EXAMS</data>
    </edge>
    <edge source="SURVEILLANCE" target="LYMPH NODE EXAM" id="related_to">
      <data key="d7">SURVEILLANCE</data>
      <data key="d8">LYMPH NODE EXAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Surveillance includes regular inguinal lymph node examinations as a recommended component. Specifically, these exams are advised every 3 to 6 months for a period of 5 years.</data>
      <data key="d12">LYMPH NODE EXAM</data>
    </edge>
    <edge source="SURVEILLANCE" target="PHYSICAL EXAMS" id="related_to">
      <data key="d7">SURVEILLANCE</data>
      <data key="d8">PHYSICAL EXAMS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Physical exams are an important part of surveillance after cervical cancer treatment</data>
      <data key="d12">PHYSICAL EXAMS</data>
    </edge>
    <edge source="SURVEILLANCE" target="COLON CANCER" id="related_to">
      <data key="d7">SURVEILLANCE</data>
      <data key="d8">COLON CANCER</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Surveillance is part of the post-treatment management for colon cancer.</data>
      <data key="d12">SURVEILLANCE</data>
    </edge>
    <edge source="SURVEILLANCE" target="DIGITAL RECTAL EXAMINATION" id="related_to">
      <data key="d7">SURVEILLANCE</data>
      <data key="d8">DIGITAL RECTAL EXAMINATION</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Digital rectal examination is a recommended component of surveillance after treatment.</data>
      <data key="d12">DIGITAL RECTAL EXAMINATION</data>
    </edge>
    <edge source="SURVEILLANCE" target="ANOSCOPY" id="related_to">
      <data key="d7">SURVEILLANCE</data>
      <data key="d8">ANOSCOPY</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Surveillance and anoscopy are closely related in post-treatment monitoring. Anoscopy is a recommended component of surveillance protocols when feasible. Specifically, after lymph node-only treatment, surveillance includes anoscopy performed every 6 to 12 months for a period of 3 years. Thus, the surveillance strategy incorporates regular anoscopic examinations to monitor for potential recurrence or complications, with the frequency and duration clearly defined in the context of lymph node-only treatment.</data>
      <data key="d12">ANOSCOPY</data>
    </edge>
    <edge source="SURVEILLANCE" target="COMPLETE REMISSION" id="related_to">
      <data key="d7">SURVEILLANCE</data>
      <data key="d8">COMPLETE REMISSION</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">A complete remission result leads to the recommended surveillance schedule described in the text</data>
      <data key="d12">COMPLETE REMISSION</data>
    </edge>
    <edge source="SURVEILLANCE" target="DIGITAL RECTAL EXAM" id="related_to">
      <data key="d7">SURVEILLANCE</data>
      <data key="d8">DIGITAL RECTAL EXAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">DREs every 3 to 6 months for 5 years are part of surveillance after lymph node-only treatment.</data>
      <data key="d12">SURVEILLANCE</data>
    </edge>
    <edge source="SURVEILLANCE" target="RECURRENCE" id="related_to">
      <data key="d7">SURVEILLANCE</data>
      <data key="d8">RECURRENCE</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Surveillance is performed to detect cancer recurrence or new cancer growth early.</data>
      <data key="d12">RECURRENCE</data>
    </edge>
    <edge source="RECURRENCE" target="ANAL CANCER" id="related_to">
      <data key="d7">RECURRENCE</data>
      <data key="d8">ANAL CANCER</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Anal cancer may return after a cancer-free period, which is called recurrence</data>
      <data key="d12">ANAL CANCER</data>
    </edge>
    <edge source="RECURRENCE" target="PHYSICAL EXAM" id="related_to">
      <data key="d7">RECURRENCE</data>
      <data key="d8">PHYSICAL EXAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">A physical exam may first raise suspicion of recurrence because of symptoms or abnormal findings.</data>
      <data key="d12">RECURRENCE</data>
    </edge>
    <edge source="RECURRENCE" target="BIOMARKER TESTING" id="related_to">
      <data key="d7">RECURRENCE</data>
      <data key="d8">BIOMARKER TESTING</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Biomarker testing plays a critical role in the management of recurrent cancers, helping to guide treatment decisions and identify potential therapeutic options. In the context of recurrent ovarian cancer, biomarker testing is used to help direct treatment by providing information that can inform which therapies are most likely to be effective for the individual patient. For recurrent cervical cancer, biomarker testing is specifically recommended for all patients with disease recurrence, as it serves to identify targeted therapy options or determine eligibility for clinical trials. Thus, across both recurrent ovarian and recurrent cervical cancers, biomarker testing is an essential tool for personalizing care after a recurrence, enabling clinicians to match patients with the most appropriate treatments, including targeted therapies, and to explore clinical trial opportunities when standard options are limited.</data>
      <data key="d12">RECURRENCE</data>
    </edge>
    <edge source="RECURRENCE" target="METASTASIS" id="related_to">
      <data key="d7">RECURRENCE</data>
      <data key="d8">METASTASIS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Recurrence can include metastasis of the cancer</data>
      <data key="d12">RECURRENCE</data>
    </edge>
    <edge source="RECURRENCE" target="BLADDER CANCER" id="related_to">
      <data key="d7">RECURRENCE</data>
      <data key="d8">BLADDER CANCER</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Bladder cancer commonly comes back after treatment</data>
      <data key="d12">RECURRENCE</data>
    </edge>
    <edge source="RECURRENCE" target="COMPLETE REMISSION" id="related_to">
      <data key="d7">RECURRENCE</data>
      <data key="d8">COMPLETE REMISSION</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Cancer can return after complete remission; if it returns more than 6 months later, the disease is considered platinum-sensitive.</data>
      <data key="d12">RECURRENCE</data>
    </edge>
    <edge source="RECURRENCE" target="BLOOD TEST" id="related_to">
      <data key="d7">RECURRENCE</data>
      <data key="d8">BLOOD TEST</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Blood tests may be ordered if symptoms or a suspicious physical exam suggest recurrent cervical cancer.</data>
      <data key="d12">RECURRENCE</data>
    </edge>
    <edge source="RECURRENCE" target="SURVIVORSHIP" id="related_to">

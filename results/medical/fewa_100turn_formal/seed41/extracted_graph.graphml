      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Metastatic anal cancer is treated first with platinum-based chemotherapy, called first-line therapy.</data>
      <data key="d12">METASTASIS</data>
    </edge>
    <edge source="METASTASIS" target="TREATMENT" id="related_to">

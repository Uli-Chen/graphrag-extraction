      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Brachytherapy may be given along with EBRT in the treatment of locally advanced cervical cancer.</data>
      <data key="d12">BRACHYTHERAPY</data>
    </edge>
    <edge source="EBRT" target="PLATINUM CHEMOTHERAPY" id="related_to">

    <edge source="CERVICAL CANCER" target="PELVIC EXAM" id="related_to">
      <data key="d7">CERVICAL CANCER</data>
      <data key="d8">PELVIC EXAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>

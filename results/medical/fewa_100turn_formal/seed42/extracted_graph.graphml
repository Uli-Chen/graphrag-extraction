    <edge source="PROSTATE CANCER" target="BLACK MALES" id="related_to">
      <data key="d7">PROSTATE CANCER</data>
      <data key="d8">BLACK MALES</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Black males are more likely to develop prostate cancer, at an earlier age, with more aggressive disease, and have higher death rates.</data>
      <data key="d12">PROSTATE CANCER</data>
    </edge>
    <edge source="PROSTATE CANCER" target="WHITE MALES" id="related_to">

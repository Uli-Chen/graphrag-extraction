    <edge source="BREAST CANCER" target="MAMMOGRAM" id="related_to">
      <data key="d7">BREAST CANCER</data>
      <data key="d8">MAMMOGRAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>

      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Transabdominal ultrasound can show the ovaries and nearby tissues during evaluation for ovarian cancer.</data>
      <data key="d12">TRANSABDOMINAL ULTRASOUND</data>
    </edge>
    <edge source="OVARIAN CANCER" target="ABDOMINAL EXAM" id="related_to">
      <data key="d7">OVARIAN CANCER</data>
      <data key="d8">ABDOMINAL EXAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The abdominal exam can reveal organ size changes, tenderness, or ascites that may be related to ovarian cancer.</data>
      <data key="d12">ABDOMINAL EXAM</data>
    </edge>
    <edge source="OVARIAN CANCER" target="UTERINE CANCER" id="related_to">

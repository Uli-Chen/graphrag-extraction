      <data key="d10">1.0</data>
      <data key="d11">The pelvic exam checks for abnormal changes in the ovaries and nearby reproductive organs that could indicate ovarian cancer.</data>
      <data key="d12">PELVIC EXAM</data>
    </edge>
    <edge source="OVARIAN CANCER" target="TRANSABDOMINAL ULTRASOUND" id="related_to">

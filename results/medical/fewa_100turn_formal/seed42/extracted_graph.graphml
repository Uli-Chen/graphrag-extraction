    </edge>
    <edge source="STAGING" target="CANCER TREATMENT" id="related_to">
      <data key="d7">STAGING</data>
      <data key="d8">CANCER TREATMENT</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Staging helps the care team select the best therapy</data>

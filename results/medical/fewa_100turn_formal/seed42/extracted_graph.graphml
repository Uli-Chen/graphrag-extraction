      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Uterine cancer is considered during the evaluation of suspected ovarian cancer, and an endometrial biopsy can rule it out.</data>
      <data key="d12">UTERINE CANCER</data>
    </edge>
    <edge source="OVARIAN CANCER" target="ENDOMETRIAL BIOPSY" id="related_to">

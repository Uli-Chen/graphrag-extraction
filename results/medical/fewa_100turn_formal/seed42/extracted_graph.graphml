    <edge source="ACUTE LYMPHOBLASTIC LEUKEMIA" target="B-CELL ACUTE LYMPHOBLASTIC LEUKEMIA" id="related_to">
      <data key="d7">ACUTE LYMPHOBLASTIC LEUKEMIA</data>
      <data key="d8">B-CELL ACUTE LYMPHOBLASTIC LEUKEMIA</data>
      <data key="d9">related_to</data>

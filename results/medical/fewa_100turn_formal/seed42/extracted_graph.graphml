      <data key="d8">PELVIC EXENTERATION</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">If the rectum is removed during pelvic exenteration, a permanent colostomy may be created.</data>
      <data key="d12">PELVIC EXENTERATION</data>
    </edge>
    <edge source="URINARY DIVERSION" target="PELVIC EXENTERATION" id="related_to">

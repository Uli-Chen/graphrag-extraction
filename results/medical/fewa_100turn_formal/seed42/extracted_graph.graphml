    <edge source="PSA TEST" target="DIAGNOSTIC TESTING" id="related_to">
      <data key="d7">PSA TEST</data>
      <data key="d8">DIAGNOSTIC TESTING</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">If a PSA test suggests prostate cancer, diagnostic testing may be offered.</data>
      <data key="d12">PSA TEST</data>
    </edge>
    <edge source="PSA TEST" target="BIOMARKER TEST" id="related_to">
      <data key="d7">PSA TEST</data>

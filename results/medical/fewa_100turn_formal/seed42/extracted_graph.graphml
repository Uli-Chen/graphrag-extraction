    <edge source="CHEMOTHERAPY" target="NAUSEA" id="related_to">
      <data key="d7">CHEMOTHERAPY</data>
      <data key="d8">NAUSEA</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Chemotherapy regimens containing irinotecan tend to cause nausea</data>
      <data key="d12">NAUSEA</data>

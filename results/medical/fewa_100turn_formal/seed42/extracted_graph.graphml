      <data key="d8">CLINICAL TRIAL</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">A drug, device, or treatment approach found safe and effective in a clinical trial may be approved by the U.S. FDA.</data>
      <data key="d12">U.S. FDA</data>
    </edge>

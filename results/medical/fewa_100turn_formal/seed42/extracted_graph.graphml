    <edge source="ACUTE LYMPHOBLASTIC LEUKEMIA" target="T-CELL ACUTE LYMPHOBLASTIC LEUKEMIA" id="related_to">
      <data key="d7">ACUTE LYMPHOBLASTIC LEUKEMIA</data>
      <data key="d8">T-CELL ACUTE LYMPHOBLASTIC LEUKEMIA</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">T-cell ALL is a subtype of acute lymphoblastic leukemia.</data>

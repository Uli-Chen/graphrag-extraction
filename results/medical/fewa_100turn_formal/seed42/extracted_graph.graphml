    </edge>
    <edge source="DOUBLE-BARRELED WET COLOSTOMY" target="PELVIC EXENTERATION" id="related_to">
      <data key="d7">DOUBLE-BARRELED WET COLOSTOMY</data>
      <data key="d8">PELVIC EXENTERATION</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>

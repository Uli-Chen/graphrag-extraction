      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">White males are the comparison group for prostate cancer risk; Black males have higher rates of diagnosis and death than white males.</data>
      <data key="d12">PROSTATE CANCER</data>
    </edge>
    <edge source="PROSTATE CANCER" target="HISPANIC MALES" id="related_to">
      <data key="d7">PROSTATE CANCER</data>
      <data key="d8">HISPANIC MALES</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Hispanic males are less likely than white and Black males to be diagnosed with prostate cancer.</data>
      <data key="d12">PROSTATE CANCER</data>
    </edge>
    <edge source="PROSTATE CANCER" target="ASIAN MALES" id="related_to">
      <data key="d7">PROSTATE CANCER</data>

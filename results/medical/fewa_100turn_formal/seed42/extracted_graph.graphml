    </edge>
    <edge source="CHEMOTHERAPY" target="ABDOMINAL CRAMPING" id="related_to">
      <data key="d7">CHEMOTHERAPY</data>
      <data key="d8">ABDOMINAL CRAMPING</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>

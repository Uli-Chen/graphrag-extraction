      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The cancer stage determined by the staging system helps guide whether chemotherapy is recommended and which chemotherapy regimen is used.</data>
      <data key="d12">CANCER STAGING</data>
    </edge>
    <edge source="CANCER STAGING" target="IMAGING TESTS" id="related_to">

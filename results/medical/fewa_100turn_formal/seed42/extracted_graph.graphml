    <edge source="BONE MARROW ASPIRATE" target="DIAGNOSTIC TESTS" id="related_to">
      <data key="d7">BONE MARROW ASPIRATE</data>
      <data key="d8">DIAGNOSTIC TESTS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">A bone marrow aspirate is a diagnostic test used to confirm AML</data>

    <edge source="ADVANCED-STAGE PROSTATE CANCER" target="TUMOR STAGING" id="related_to">
      <data key="d7">ADVANCED-STAGE PROSTATE CANCER</data>
      <data key="d8">TUMOR STAGING</data>

    <edge source="NATIONAL CANCER INSTITUTE" target="CLINICAL TRIAL" id="related_to">
      <data key="d7">NATIONAL CANCER INSTITUTE</data>
      <data key="d8">CLINICAL TRIAL</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The National Cancer Institute (NCI) provides comprehensive clinical trial information and search resources. These resources are available through the NCI's official website at cancer.gov/about-cancer/treatment/clinical-trials/search, where patients, caregivers, and researchers can locate ongoing clinical trials. In addition to the online search tool, the National Cancer Institute's Cancer Information Service is also available to help individuals find clinical trials that may be relevant to their needs. Together, these offerings ensure that the public has access to both self-service search tools and personalized assistance when seeking information about clinical trials.</data>
      <data key="d12">NATIONAL CANCER INSTITUTE</data>
    </edge>
    <edge source="U.S. NATIONAL LIBRARY OF MEDICINE" target="CLINICAL TRIAL" id="related_to">
      <data key="d7">U.S. NATIONAL LIBRARY OF MEDICINE</data>
      <data key="d8">CLINICAL TRIAL</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The U.S. National Library of Medicine maintains ClinicalTrials.gov, a comprehensive worldwide clinical trial registry and search database. This resource is provided by the U.S. National Library of Medicine to help users find clinical trials. ClinicalTrials.gov serves as a global repository, allowing researchers, patients, and the public to locate and access information about clinical trials conducted around the world.</data>
      <data key="d12">U.S. NATIONAL LIBRARY OF MEDICINE</data>
    </edge>
    <edge source="U.S. FDA" target="CLINICAL TRIAL" id="related_to">

    </edge>
    <edge source="CT SCAN" target="DIAGNOSIS" id="related_to">
      <data key="d7">CT SCAN</data>
      <data key="d8">DIAGNOSIS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">A CT scan produces detailed images that are used as part of diagnostic testing for cancer</data>
      <data key="d12">CT SCAN</data>
    </edge>
    <edge source="CT SCAN" target="PRIMARY CNS LYMPHOMA" id="related_to">
      <data key="d7">CT SCAN</data>
      <data key="d8">PRIMARY CNS LYMPHOMA</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">CT scan is an imaging test used to diagnose primary CNS lymphoma</data>

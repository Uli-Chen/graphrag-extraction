      <data key="d8">PELVIC EXENTERATION</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">If the bladder is removed during pelvic exenteration, a urinary diversion is typically performed.</data>
      <data key="d12">PELVIC EXENTERATION</data>
    </edge>

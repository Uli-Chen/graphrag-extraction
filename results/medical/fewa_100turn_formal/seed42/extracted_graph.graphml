      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Cancer treatment is a specific type of treatment.</data>
      <data key="d12">CANCER TREATMENT</data>
    </edge>
    <edge source="TREATMENT" target="PATIENT" id="related_to">

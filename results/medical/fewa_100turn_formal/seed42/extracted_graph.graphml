      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Imaging tests take pictures of the inside of the body and are used during cancer staging and treatment planning.</data>
      <data key="d12">CANCER STAGING</data>
    </edge>

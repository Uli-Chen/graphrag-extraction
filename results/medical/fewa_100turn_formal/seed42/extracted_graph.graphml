      <data key="d7">PSA TEST</data>
      <data key="d8">PHI</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">PHI can be used in addition to PSA to help decide whether further testing is needed.</data>
      <data key="d12">PSA TEST</data>
    </edge>

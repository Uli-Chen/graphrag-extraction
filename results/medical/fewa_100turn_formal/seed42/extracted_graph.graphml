      <data key="d12">ADVANCED-STAGE PROSTATE CANCER</data>
    </edge>
    <edge source="ADVANCED-STAGE PROSTATE CANCER" target="METASTATIC PROSTATE CANCER" id="related_to">
      <data key="d7">ADVANCED-STAGE PROSTATE CANCER</data>
      <data key="d8">METASTATIC PROSTATE CANCER</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Metastatic prostate cancer is one of the two types of advanced-stage prostate cancer</data>
      <data key="d12">ADVANCED-STAGE PROSTATE CANCER</data>
    </edge>
    <edge source="ADVANCED-STAGE PROSTATE CANCER" target="REGIONAL PROSTATE CANCER" id="related_to">
      <data key="d7">ADVANCED-STAGE PROSTATE CANCER</data>
      <data key="d8">REGIONAL PROSTATE CANCER</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Regional prostate cancer is one of the two types of advanced-stage prostate cancer</data>
      <data key="d12">ADVANCED-STAGE PROSTATE CANCER</data>
    </edge>
    <edge source="ADVANCED-STAGE PROSTATE CANCER" target="TREATMENT" id="related_to">
      <data key="d7">ADVANCED-STAGE PROSTATE CANCER</data>
      <data key="d8">TREATMENT</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Treatment can slow advanced-stage prostate cancer, reduce symptoms, and help people live longer</data>
      <data key="d12">ADVANCED-STAGE PROSTATE CANCER</data>
    </edge>
    <edge source="ADVANCED-STAGE PROSTATE CANCER" target="METASTASIS" id="related_to">
      <data key="d7">ADVANCED-STAGE PROSTATE CANCER</data>
      <data key="d8">METASTASIS</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Advanced-stage prostate cancer is defined by metastasis, meaning the cancer has spread beyond the prostate to other parts of the body. This condition is characterized by the movement of cancerous cells from the prostate gland to distant sites, such as bones, lymph nodes, or other organs. In the context of this disease, metastasis is the key feature that distinguishes advanced-stage prostate cancer from localized prostate cancer, which remains confined within the prostate. Thus, advanced-stage prostate cancer and metastasis are closely linked, with the latter serving as the defining criterion for the former.</data>
      <data key="d12">ADVANCED-STAGE PROSTATE CANCER</data>
    </edge>
    <edge source="ADVANCED-STAGE PROSTATE CANCER" target="PROSTATE CANCER" id="related_to">
      <data key="d7">ADVANCED-STAGE PROSTATE CANCER</data>
      <data key="d8">PROSTATE CANCER</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Advanced-stage prostate cancer is a later, more severe form of prostate cancer</data>
      <data key="d12">PROSTATE CANCER</data>
    </edge>
    <edge source="ADVANCED-STAGE PROSTATE CANCER" target="TREATMENT TEAM" id="related_to">
      <data key="d7">ADVANCED-STAGE PROSTATE CANCER</data>
      <data key="d8">TREATMENT TEAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">A treatment team works with the patient to choose the best treatments for advanced-stage prostate cancer.</data>
      <data key="d12">ADVANCED-STAGE PROSTATE CANCER</data>
    </edge>
    <edge source="ADVANCED-STAGE PROSTATE CANCER" target="EARLY-STAGE PROSTATE CANCER" id="related_to">
      <data key="d7">ADVANCED-STAGE PROSTATE CANCER</data>
      <data key="d8">EARLY-STAGE PROSTATE CANCER</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Early-stage and advanced-stage prostate cancer are the two main groupings of prostate cancer, distinguished by whether the cancer has spread beyond the prostate</data>
      <data key="d12">PROSTATE CANCER</data>
    </edge>
    <edge source="MOLECULAR BIOMARKER TESTING" target="PATIENT" id="related_to">
      <data key="d7">MOLECULAR BIOMARKER TESTING</data>
      <data key="d8">PATIENT</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The patient may have biomarker testing to determine prostate cancer risk.</data>
      <data key="d12">MOLECULAR BIOMARKER TESTING</data>
    </edge>
    <edge source="MOLECULAR BIOMARKER TESTING" target="TREATMENT" id="related_to">
      <data key="d7">MOLECULAR BIOMARKER TESTING</data>
      <data key="d8">TREATMENT</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Biomarker testing results indicate whether treatment should be avoided or delayed.</data>
      <data key="d12">MOLECULAR BIOMARKER TESTING</data>
    </edge>
    <edge source="MOLECULAR BIOMARKER TESTING" target="SURGERY" id="related_to">
      <data key="d7">MOLECULAR BIOMARKER TESTING</data>
      <data key="d8">SURGERY</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">If molecular biomarker testing indicates lower-risk cancer, surgery may be avoided or delayed.</data>
      <data key="d12">MOLECULAR BIOMARKER TESTING</data>
    </edge>
    <edge source="MOLECULAR BIOMARKER TESTING" target="RADIATION THERAPY" id="related_to">
      <data key="d7">MOLECULAR BIOMARKER TESTING</data>
      <data key="d8">RADIATION THERAPY</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">If molecular biomarker testing indicates lower-risk cancer, radiation therapy may be avoided or delayed.</data>
      <data key="d12">MOLECULAR BIOMARKER TESTING</data>
    </edge>
    <edge source="MOLECULAR BIOMARKER TESTING" target="CARE TEAM" id="related_to">
      <data key="d7">MOLECULAR BIOMARKER TESTING</data>
      <data key="d8">CARE TEAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">The care team considers biomarker testing results when assessing risk.</data>
      <data key="d12">MOLECULAR BIOMARKER TESTING</data>
    </edge>
    <edge source="URINE TEST" target="DIAGNOSTIC TESTING" id="related_to">
      <data key="d7">URINE TEST</data>
      <data key="d8">DIAGNOSTIC TESTING</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">If urine tests suggest prostate cancer, diagnostic testing may be offered.</data>
      <data key="d12">DIAGNOSTIC TESTING</data>
    </edge>

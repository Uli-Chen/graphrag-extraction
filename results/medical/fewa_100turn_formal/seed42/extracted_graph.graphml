      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Biopsy is a medical procedure</data>
      <data key="d12">MEDICAL PROCEDURE</data>
    </edge>
    <edge source="BIOPSY" target="GENETIC TESTING" id="related_to">
      <data key="d7">BIOPSY</data>
      <data key="d8">GENETIC TESTING</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Genetic testing can be performed on tumor tissue, and biopsy provides tissue samples for such testing.</data>
      <data key="d12">GENETIC TESTING</data>
    </edge>

      <data key="d8">COLORECTAL CANCER</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Colon cancer is a colorectal cancer that forms in the colon</data>
      <data key="d12">COLON CANCER</data>
    </edge>
    <edge source="COLON CANCER" target="POLYPS" id="related_to">

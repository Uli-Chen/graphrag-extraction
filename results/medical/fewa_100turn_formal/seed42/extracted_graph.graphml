      <data key="d8">ELECTROCARDIOGRAM</data>
      <data key="d9">related_to</data>
      <data key="d10">1.0</data>
      <data key="d11">Electrocardiogram is a heart test that shows electrical changes in the heart</data>
      <data key="d12">HEART TESTS</data>
    </edge>
